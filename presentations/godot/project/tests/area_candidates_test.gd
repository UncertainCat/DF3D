extends SceneTree
var failures := 0
class RefreshService extends RefCounted:
	signal session_changed
	var calls: Array = []
	var detached: Array = []
	func submit(_domain, request, observer) -> int:
		calls.append({"request":request,"observer":observer}); return calls.size()
	func detach(ticket) -> void: detached.append(ticket)
	func reply(index: int, page: Dictionary) -> void:
		calls[index].observer.call(index+1,{"status":2,"action":14,"area":page},calls[index].request)
func check(value: bool, message: String) -> void:
	if not value: failures += 1; push_error(message)
func _initialize() -> void: call_deferred("run")
func run() -> void:
	var colors = preload("res://scripts/native_name_color.gd")
	var flash := {"color":[3,3,1],"alternate":[0,3,0],"effect":1}
	for time in [0,332,333,999,1000,1332,1333]:
		check(colors.choose(flash,time,0) == (flash.alternate if time%1000 < 333 else flash.color),"legendary native duty cycle")
	flash.effect = 2
	for time in [0,499,500,999,1000,1499,1500]:
		check(colors.choose(flash,time,0) == (flash.alternate if time%1000 < 500 else flash.color),"nemesis native duty cycle")
	flash.effect = 3
	check(colors.choose(flash,0,0) == flash.color and colors.choose(flash,0,1) == flash.alternate,"fire uses injected presentation randomness")
	flash.effect = 0
	check(colors.choose(flash,0,0).is_empty(),"inconsistent steady color rejected")
	check(colors.choose({},0,0).is_empty(),"unknown historical color stays unknown")
	var state := preload("res://scripts/area_candidates_state.gd").new()
	var sent: Array = []; state.request_ready.connect(func(request): sent.append(request))
	var area := {"id":82,"kind":1,"revision":9007199254740993,"owner_allowed":true,"owner_id":17,"zone_type":92}
	var fresh = preload("res://scripts/area_candidates_state.gd").new()
	var service := RefreshService.new()
	var refresh = preload("res://scripts/area_owner_refresh.gd").new()
	refresh.configure(service,fresh)
	fresh.open(area)
	fresh.accept({"list_revision":123,"candidates":[{"id":21,"name":"Before"},{"id":22,"name":"Second"}],"next_cursor":0},fresh.pending.duplicate(true))
	refresh.poll(0.9,0); check(service.calls.is_empty(),"owner refresh cadence is bounded")
	refresh.poll(0.1,0); check(service.calls.size()==1 and not fresh.busy(),"background facts do not block assignment")
	check(service.calls[0].request.candidate_limit==18,"background refresh covers the visible rows only")
	var facts := {"operation":14,"candidate_kind":1,"query":"","sort":2,"sort_descending":false,"list_revision":123,"candidates":[{"id":21,"name":"After"},{"id":22,"name":"Second"}]}
	var oversized: Dictionary = facts.duplicate(true); oversized.candidates.append({"id":23})
	var limited: Dictionary = service.calls[0].request.duplicate(true); limited.candidate_limit=2
	fresh.accept_owner_facts(oversized,limited)
	check(fresh.rows[0].name=="Before","oversized refresh cannot partially update loaded rows")
	service.reply(0,facts)
	check(fresh.rows[0].name=="After" and fresh.receipt==123 and fresh.cursor==0,"facts update without changing pagination")
	refresh.poll(1,0)
	var wrong: Dictionary = facts.duplicate(true); wrong.candidates[1].id=23; wrong.candidates[0].name="Partial"
	service.reply(1,wrong)
	check(fresh.rows[0].name=="After","mismatched membership rejects entire page")
	refresh.poll(1,0); fresh.queue_owner_search(PackedByteArray([195]))
	check(service.detached.has(3),"search immediately detaches background read")
	service.reply(2,facts); check(fresh.rows.is_empty(),"late facts cannot replace query")
	fresh.open(area); fresh.accept({"list_revision":123,"candidates":[{"id":21}]},fresh.pending.duplicate(true))
	refresh.poll(1,0); fresh.assign_owner(21); service.reply(3,facts)
	check(fresh.mutating and not fresh.rows[0].has("name"),"assignment retires background facts")
	fresh.open(area); fresh.accept({"list_revision":123,"candidates":[{"id":21}]},fresh.pending.duplicate(true))
	refresh.poll(1,0); service.session_changed.emit(); service.reply(4,facts)
	check(not fresh.rows[0].has("name"),"session invalidation retires background facts")
	refresh.poll(1,0); fresh.clear(); service.reply(5,facts)
	check(fresh.rows.is_empty() and refresh.ticket==0,"closed picker rejects background facts")
	service.calls.clear();service.detached.clear()
	fresh.open(area)
	var resize_rows:Array=[]
	for index in 30:resize_rows.append({"id":index})
	fresh.accept({"list_revision":123,"candidates":resize_rows},fresh.pending.duplicate(true))
	refresh.poll(0,0,21)
	check(service.calls.size()==1 and service.calls[0].request.candidate_limit==21,"tall picker requests every visible row")
	refresh.poll(0,0,13)
	check(service.detached.has(1) and service.calls.size()==2 and service.calls[1].request.candidate_limit==13,"resize retires the obsolete visible range immediately")
	var old_resize:Dictionary=facts.duplicate(true);old_resize.candidates=[{"id":0,"name":"stale"}]
	service.reply(0,old_resize)
	check(not fresh.rows[0].has("name"),"late old-height facts cannot replace the resized range")
	fresh.clear();service.calls.clear();service.detached.clear()
	var recipes: Array = []
	for index in 96: recipes.append({"id":index,"sheet_icon":{"layers":[[index]],"tile_pages":["fixture"]}})
	fresh.open(area); fresh.accept({"list_revision":456,"candidates":recipes},fresh.pending.duplicate(true))
	check(fresh.rows.filter(func(row):return row.has("sheet_icon")).size()==36,"initial owner recipe retention is bounded")
	check(recipes[95].has("sheet_icon"),"recipe eviction does not mutate source receipts")
	refresh.poll(0,40)
	check(service.calls.size()==1 and service.calls[0].request.cursor==40,"scroll requests new visible facts immediately")
	check(not fresh.rows[0].has("sheet_icon") and fresh.rows.size()==96,"recipe eviction retains list membership")
	var scrolled := {"operation":14,"candidate_kind":1,"query":"","sort":2,"sort_descending":false,"list_revision":456,"candidates":recipes.slice(40,58)}
	service.reply(0,scrolled)
	check(fresh.rows[40].has("sheet_icon") and fresh.rows.filter(func(row):return row.has("sheet_icon")).size()<=36,"visible recipes reacquired within bounded retention")
	refresh.poll(0,0)
	check(service.calls.size()==2 and service.calls[1].request.cursor==0,"return scroll requests evicted recipes immediately")
	scrolled.candidates=recipes.slice(0,18);service.reply(1,scrolled)
	check(fresh.rows[0].has("sheet_icon") and not fresh.rows[40].has("sheet_icon"),"return scroll restores only current window")
	refresh.poll(1,40);refresh.poll(0,0)
	check(service.detached.has(3),"scroll change detaches obsolete viewport read")
	fresh.clear();service.calls.clear();service.detached.clear()
	var animals: Array=[]
	for index in 96:
		animals.append({"id":index/2,"entity":1+index%2,"sheet_icon":{"layers":[[index]]},"animal_container":{"occupant":{"layers":[[index]]}}})
	fresh.open(area,2);fresh.accept({"list_revision":789,"candidates":animals},fresh.pending.duplicate(true))
	check(fresh.rows.filter(func(row):return row.has("sheet_icon") or row.has("animal_container")).size()==36,"animal portraits and container recipes share retention bound")
	check(animals[95].has("animal_container"),"animal eviction preserves source snapshot")
	refresh.poll(1,0)
	check(service.calls[0].request.candidate_kind==2 and not fresh.busy(),"animal background refresh keeps input available")
	var animal_facts:Dictionary={"operation":14,"candidate_kind":2,"query":"","sort":2,"sort_descending":false,"list_revision":789,"candidates":animals.slice(0,18)}
	var collision:Dictionary=animal_facts.duplicate(true);collision.candidates[0].entity=2
	collision.candidates[1].name="Must not update"
	service.reply(0,collision)
	check(not fresh.rows[1].has("name"),"typed ID collision rejects entire animal fact page")
	refresh.poll(0,40);check(service.calls[1].request.cursor==40,"animal scroll requests current window")
	animal_facts.candidates=animals.slice(40,58);service.reply(1,animal_facts)
	check(fresh.rows[40].has("animal_container") and not fresh.rows[0].has("animal_container"),"animal container recipes evicted and reacquired by viewport")
	refresh.poll(1,40);fresh.queue_owner_search(PackedByteArray([195]));service.reply(2,animal_facts)
	check(fresh.rows.is_empty() and service.detached.has(3),"animal query retires background facts")
	for retirement in ["order","mutation","session","close"]:
		fresh.open(area,2);fresh.accept({"list_revision":789,"candidates":animals.slice(0,2)},fresh.pending.duplicate(true))
		refresh.poll(1,0);var last:=service.calls.size()-1
		match retirement:
			"order":fresh.order(1)
			"mutation":fresh.toggle_animal(1,0)
			"session":service.session_changed.emit()
			"close":fresh.clear()
		animal_facts.candidates=animals.slice(0,2).duplicate(true);animal_facts.candidates[0].name="Late"
		service.reply(last,animal_facts)
		check(fresh.rows.is_empty() or not fresh.rows[0].has("name"),"animal "+retirement+" retires late facts")
	fresh.clear();service.calls.clear()
	state.open(area)
	check(sent[-1] == {"action":14,"operation":14,"id":82,"kind":1,"candidate_kind":1,"query":"","sort":2,"sort_descending":false,"cursor":0},"owner selector uses enriched native candidate request")
	state.accept({"build_phase":1,"build_done":1,"build_total":20},sent[-1])
	state.poll(0.249); check(sent.size() == 1,"pending list is not continuously polled")
	state.poll(0.001); check(sent.size() == 2,"pending builder polls after 250ms")
	state.queue_search("Urist")
	state.accept({"list_revision":7,"candidates":[{"id":17,"name":"Old result"}]},sent[-1])
	check(state.rows.is_empty(),"old query reply cannot replace the newer search")
	state.poll(0.25); check(sent[-1].query == "Urist","latest search starts after obsolete reply retires")
	state.accept({"list_revision":9007199254740993,"build_phase":3,"candidates":[{"id":21,"name":"Urist","profession":"Miner","sex":1,"mood":3}],"next_cursor":1},sent[-1])
	check(state.busy(),"partial owner membership blocks assignment and navigation")
	state.assign_owner(21); check(not state.mutating,"partial owner list cannot assign")
	state.poll(0)
	check(sent[-1].cursor == 1 and sent[-1].expected_list_revision == 9007199254740993,"pagination retains exact list receipt")
	state.accept({"list_revision":9007199254740993,"candidates":[{"id":22,"name":"Urist Two"}],"next_cursor":0},sent[-1])
	check(not state.busy() and state.rows.size() == 2 and state.rows[0].profession == "Miner","phase3 pages retain observed owner metadata")
	state.assign_owner(999)
	check(not state.mutating,"unobserved owner identity is not submitted")
	state.assign_owner(22)
	check(sent[-1] == {"action":11,"id":82,"kind":1,"expected_revision":9007199254740993,"owner_id":22},"owner edit sends observed identity and exact area revision")
	var count := sent.size(); state.assign_owner(21); state.order(1); state.queue_search("Other")
	check(sent.size() == count and state.area.owner_id == 17,"pending assignment cannot be duplicated or optimistically applied")
	state.clear(); state.accept({"list_revision":8,"candidates":[{"id":99}]},sent[-1])
	check(state.rows.is_empty() and state.area.is_empty(),"closed state rejects late page")
	state.open(area); state.accept({"list_revision":1,"candidates":[],"next_cursor":0},sent[-1])
	state.assign_owner(-1)
	check(sent[-1].owner_id == -1,"remove assignment is available even with empty candidate results")
	for type_id in [80,92,93,97]:
		var room: Dictionary = area.duplicate(true); room.zone_type = type_id; room.owner_id = -1
		state.open(room); state.accept({"list_revision":1,"candidates":[]},sent[-1])
		count = sent.size(); state.assign_owner(-1)
		check((sent.size() == count+1) == (type_id != 97),"native room contexts permit empty clear, Tomb has no clear action")
		if type_id != 97: check(sent[-1].owner_id == -1 and state.mutating,"empty clear still awaits native receipt")
	state.open(area); state.accept({"build_phase":1,"build_total":20},sent[-1])
	state.order(1); state.poll(0)
	check(sent[-1].sort == 1 and not sent[-1].sort_descending,"sort supersedes waiting builder without polling obsolete order")
	state.accept({"list_revision":3,"candidates":[],"next_cursor":1},sent[-1])
	state.order(1); state.poll(0)
	check(sent[-1].sort_descending,"second sort click reverses direction")
	state.accept({"list_revision":4,"candidates":[],"next_cursor":0},sent[-1])
	state.order(4); state.poll(0)
	check(sent[-1].sort == 4 and not sent[-1].sort_descending,"stress header uses its own native sort")
	state.accept({"list_revision":4,"candidates":[],"next_cursor":0},sent[-1])
	state.order(4); state.poll(0)
	check(sent[-1].sort_descending,"stress header reverses independently")
	state.accept({"list_revision":4,"candidates":[],"next_cursor":0},sent[-1])
	state.order(1); state.poll(0)
	check(sent[-1].sort_descending and state.sort_direction(4),"returning to Name retains both header directions")
	state.accept({"list_revision":4,"candidates":[],"next_cursor":1},sent[-1]); state.more()
	state.accept({"list_revision":5,"candidates":[{"id":99}]},sent[-1])
	check(state.failed and state.rows.is_empty(),"changed receipt cannot mix candidate snapshots")
	state.clear(); state.open(area); state.accept({"query":"Wrong","list_revision":8},sent[-1])
	check(state.failed,"mismatched page query fails closed")
	for selector_kind in [1,2]:
		state.open(area,selector_kind)
		state.queue_owner_search(PackedByteArray([195]))
		state.accept({"list_revision":9,"candidates":[{"id":99}]},sent[-1])
		state.poll(0.25)
		check(sent[-1].query == "" and sent[-1].query_bytes == PackedByteArray([195]),"partial UTF-8 request stays raw")
		var old_raw: Dictionary = sent[-1].duplicate(true)
		state.queue_owner_search(PackedByteArray([195,169]))
		state.accept({"query_bytes":PackedByteArray([195]),"list_revision":10,"candidates":[{"id":99}]},old_raw)
		check(state.rows.is_empty(),"obsolete raw query cannot replace new editor bytes")
		state.poll(0.25)
		state.accept({"query_bytes":PackedByteArray([195,169]),"list_revision":11,"candidates":[],"next_cursor":1},sent[-1])
		state.more()
		check(sent[-1].query_bytes == PackedByteArray([195,169]) and sent[-1].expected_list_revision == 11,"continuation preserves raw query")
		state.accept({"query_bytes":PackedByteArray([195]),"list_revision":11},sent[-1])
		check(state.failed,"wrong raw echo rejected even when text query is empty")
		state.open(area,selector_kind,{"query_bytes":PackedByteArray([195])})
		check(sent[-1].query_bytes == PackedByteArray([195]),"reopened navigation preserves partial bytes")
		state.accept({"list_revision":11},sent[-1])
		check(state.failed,"missing raw echo is not accepted as an empty query")
	state.open(area,2,{"query":"goat","sort":1,"descending":true})
	state.accept({"list_revision":11,"candidates":[{"id":24,"entity":1,"name":"Goat","assigned":false,"grazer":true}]},sent[-1])
	state.toggle_animal(1,24)
	check(sent[-1] == {"action":11,"operation":11,"kind":1,"id":82,"expected_revision":9007199254740993,"unit_id":24,"assign":1},"animal selection sends isolated native assignment")
	check(not state.rows[0].assigned,"animal checkbox remains observed while mutation pending")
	area.revision += 1; state.open(area,2,{"query":"goat","sort":1,"descending":true})
	check(sent[-1].query == "goat" and sent[-1].sort_descending,"animal refresh retains search and sort")
	state.accept({"list_revision":12,"candidates":[{"id":24,"entity":1,"name":"Goat","assigned":true}]},sent[-1])
	state.toggle_animal(1,24)
	check(sent[-1].assign == 0 and sent[-1].expected_revision == area.revision,"animal deselection uses refreshed revision")
	state.open(area,2)
	check(sent[-1].sort == 2 and not sent[-1].sort_descending,"animal chooser opens Category ascending")
	state.accept({"list_revision":13,"candidates":[]},sent[-1])
	state.order(1); state.poll(0)
	check(sent[-1].sort == 1 and not sent[-1].sort_descending,"animal Name first click is ascending")
	state.accept({"list_revision":14,"candidates":[]},sent[-1])
	state.order(1); state.poll(0)
	check(sent[-1].sort_descending,"animal Name second click is descending")
	state.accept({"list_revision":15,"candidates":[]},sent[-1])
	state.order(2); state.poll(0)
	check(not sent[-1].sort_descending and state.sort_direction(1),"animal Category retains own direction and Name arrow remembers descending")
	state.accept({"list_revision":16,"candidates":[]},sent[-1])
	state.order(1); state.poll(0)
	check(sent[-1].sort_descending,"returning to animal Name retains its direction")
	# Unit and item namespaces may contain the same numeric ID.
	state.open(area,2)
	state.accept({"list_revision":13,"candidates":[
		{"id":24,"entity":1,"name":"Unit","assigned":false},
		{"id":24,"entity":2,"name":"Item","assigned":true},
		{"id":25,"name":"Legacy","assigned":false}]},sent[-1])
	count = sent.size()
	state.toggle_animal(0,25)
	state.toggle_animal(1,25)
	state.toggle_animal(3,24)
	state.toggle_animal(2,-1)
	check(sent.size() == count and not state.mutating,"unknown, missing and invalid typed identities cannot submit")
	state.toggle_animal(2,24)
	check(sent[-1] == {"action":11,"operation":11,"kind":1,"id":82,"expected_revision":area.revision,"item_id":24,"assign":0},"colliding item ID selects item assignment and item observed state")
	check(not state.rows[0].assigned and state.rows[1].assigned,"typed assignment preserves observed rows while pending")
	count = sent.size()
	state.toggle_animal(1,24)
	check(sent.size() == count,"pending item mutation blocks unit mutation")
	state.open(area,2)
	state.accept({"list_revision":14,"candidates":[
		{"id":24,"entity":2,"assigned":true},{"id":24,"entity":1,"assigned":false}]},sent[-1])
	state.toggle_animal(1,24)
	check(sent[-1].unit_id == 24 and not sent[-1].has("item_id") and sent[-1].assign == 1,"colliding unit ID uses unit state regardless of row order")
	state.open(area,2)
	state.accept({"list_revision":15,"candidates":[{"id":24,"entity":1}],"next_cursor":1},sent[-1])
	check(state.busy(),"animal scrollbar waits for complete retained membership")
	state.poll(0)
	check(sent[-1].cursor==1 and sent[-1].expected_list_revision==15,"animal membership automatically requests bounded continuation")
	state.accept({"list_revision":15,"candidates":[{"id":25,"entity":2}]},sent[-1])
	check(not state.busy() and state.rows.size()==2,"animal membership completes before navigation")
	state.open(area,3)
	state.accept({"list_revision":13,"candidates":[{"id":8,"name":"Squad","squad_use":5}]},sent[-1])
	state.toggle_squad(8,2)
	check(sent[-1].operation == 12 and sent[-1].squad_id == 8 and sent[-1].squad_use == 7,"training toggle preserves other observed barracks flags")
	state.open(area,3,{"squad_mask":2})
	state.accept({"list_revision":14,"candidates":[{"id":8,"name":"Squad","squad_use":2}]},sent[-1])
	count = sent.size(); state.toggle_squad(8,1)
	check(sent.size() == count,"archery selector cannot submit sleep use")
	state.toggle_squad(8,2)
	check(sent[-1].squad_use == 0,"archery training can be removed")
	var locations := preload("res://scripts/area_locations_state.gd").new()
	locations.request_ready.connect(func(request): sent.append(request))
	locations.open(area)
	locations.accept({"list_revision":9007199254740993,"locations":[{"id":0,"name":"Library"}],"next_cursor":1},sent[-1])
	locations.more()
	check(sent[-1].expected_list_revision == 9007199254740993 and sent[-1].cursor == 1,"location paging carries exact receipt")
	locations.accept({"list_revision":9007199254740993,"locations":[{"id":5,"name":"Tavern"}]},sent[-1])
	check(locations.rows.size() == 2,"location pages accumulate observed identities")
	count = sent.size(); locations.assign(99)
	check(sent.size() == count,"unknown location cannot mutate")
	for kind in [2,4]:
		locations.create(kind)
		check(sent[-1].action == preload("res://scripts/management_contract.gd").ManagementAction.AreaInspect and sent[-1].operation == preload("res://scripts/management_contract.gd").AreaOperation.LocationChoices and sent[-1].location_kind == kind and not locations.mutating,"religion/guild creation first reads authoritative choices")
		count = sent.size(); locations.choose_catalog(0)
		check(sent.size() == count,"unobserved creation choice cannot mutate")
		locations.back_catalog()
	locations.assign(0)
	check(sent[-1].location_id == 0 and sent[-1].expected_revision == area.revision,"zero location identity remains selectable")
	locations.clear(); locations.accept({"list_revision":99,"locations":[{"id":99}]},sent[-1])
	check(locations.rows.is_empty(),"closed location selector ignores late rows")
	locations.open(area); locations.accept({"list_revision":2,"locations":[],"next_cursor":1},sent[-1]); locations.more()
	locations.accept({"list_revision":3,"locations":[{"id":99}]},sent[-1])
	check(locations.failed and locations.rows.is_empty(),"location pages cannot mix list revisions")
	print("AREA_CANDIDATES PASS" if failures == 0 else "AREA_CANDIDATES FAIL")
	quit(failures)
