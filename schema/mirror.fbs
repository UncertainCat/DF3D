// Mirror schema — the single canonical definition.
//
// GAME SEMANTICS ONLY: no sprite, color, mesh, atlas, or any
// other visual vocabulary may appear in this file — with one ruled
// exception: *appearance references* — DF's own
// resolved creature-graphics layers, named by the install's raw
// identifiers (tile page token, tile coordinates, palette file, palette
// row), for units (v3) and for corpse items (v5) — and DF's own classic
// glyph data from the raws (`CREATURE_TILE` / `COLOR`, material `TILE` /
// `BASIC_COLOR`, itemdef `TILE`; v5), so a presentation can draw anything
// DF has no sprite for the way classic DF draws it. Both are references
// into the user's install, never pixels.
//
// Every snapshot carries SchemaVersion.Current; consumers reject mismatches.

namespace df3d.mirror;

file_identifier "DF3S";

enum SchemaVersion : uint32 { Current = 11 }

/// Semantic activity of a unit. Grows as bridge coverage grows; values are
/// append-only (never renumber).
enum JobKind : uint16 {
  Idle = 0,
  Mine,
  HaulItem,
  ConstructBuilding,
  Sleep,
  Eat,
  Drink,
  Fight,
  Flee,
}

struct TilePos {
  x: int32;
  y: int32;
  z: int32;
}

/// Currently observed melee attack intent, not evidence of a hit. DF action
/// identity is scoped to the attacking unit. Targets must be mirrored units.
table UnitAttack {
  action_id:int32 = -1;
  target_unit_id:int32 = -1;
  /// Raw DF counters: timer1 is wind-up, timer2 is subsequent recovery.
  /// No impact time or outcome is inferred from these counters.
  timer1:int32;
  timer2:int32;
}

table UnitState {
  id: uint64 (key);
  /// Required in practice; validators reject units without a position.
  pos: TilePos;
  /// Creature raw identifier, e.g. "DWARF", "GOBLIN". A string because DF
  /// creatures are moddable and procedurally generated — a closed enum
  /// cannot enumerate them.
  species: string;
  job: JobKind = Idle;
  /// Optional additive v7 field; old recordings have no attack observations.
  attack: UnitAttack;
  /// Current physical body volume in cubic centimeters. Zero means unknown.
  body_volume_cm3:uint32;
  /// Optional semantic condition facts; absent in earlier recordings.
  /// Bit43: Baby, from the source baby classification; not a size heuristic.
  status_flags:uint64 = 0;
}

// --- Terrain ---
// Granularity is the DF map block: 16x16 tiles at one z level. All enums
// below are append-only (never renumber).

/// Structural shape of a tile. Semantic vocabulary only.
enum TileShape : uint8 {
  Empty = 0,       // open air / nothing here
  Wall,
  Floor,
  Ramp,
  RampTop,         // the open tile above a ramp
  StairUp,
  StairDown,
  StairUpDown,
  Fortification,
  Boulder,
  Pebbles,
  TreeTrunk,
  TreeBranch,
  Shrub,
  Sapling,
  Unknown,         // bridge could not classify; consumers treat as opaque
}

/// Broad class of the substance a tile is made of. The exact raw identifier
/// is `TileState.material` (index into `Snapshot.materials`). Water/Magma
/// are reserved for tiles whose own substance is a liquid product; flowing
/// liquid on a tile is carried by `liquid_kind`/`liquid_level` instead so a
/// flooded floor keeps its floor material.
enum MaterialKind : uint8 {
  None = 0,
  Stone,
  Soil,
  Mineral,         // ore / gem veins embedded in stone layers
  Gem,
  Ice,
  Wood,
  Plant,
  Grass,
  Constructed,
  Water,
  Magma,
  Unknown,
}

/// Liquid present on a tile (independent of the tile's own material).
enum LiquidKind : uint8 {
  None = 0,
  Water,
  Magma,
}

/// Per-tile flags (bitfield). Values are single bits.
enum TileFlags : uint8 (bit_flags) {
  Hidden,          // not yet revealed to the player
  DigDesignated,   // any dig/channel/ramp/stair designation
  Smooth,          // already smoothed (tiletype special SMOOTH / TRACK)
  Engraved,
  Outside,         // open to the sky
  /// v6: a pending smooth designation (DF `designation.smooth`
  /// = 1) — the work is not done yet; `Smooth` is the finished state.
  SmoothDesignated,
  /// v6: a pending engrave designation (`designation.smooth` = 2).
  EngraveDesignated,
  DigAuto, // native occupancy.dig_auto, automatic vein mining
}

/// Pending operation, whether represented by a native designation or an active
/// tile job. Unknown is reserved for older fixtures that carried only flags.
enum DesignationKind : uint8 {
  None = 0, Dig, Channel, StairUp, StairDown, StairUpDown, Ramp,
  RemoveConstruction, Chop, Gather, Smooth, Engrave, Fortify, Unknown
}

/// Fixed-size per-tile state (8 bytes; 256 per MapBlock).
struct TileState {
  shape: TileShape;
  material_kind: MaterialKind;
  /// Index into `Snapshot.materials` of the same snapshot; 0xFFFF = none.
  material: uint16;
  /// 0..7 on DF's scale; 0 means no liquid (then liquid_kind must be None,
  /// and vice versa).
  liquid_level: uint8;
  liquid_kind: LiquidKind;
  flags: TileFlags;
  designation: DesignationKind;
}

/// Sparse per-block designation metadata. Absent entries mean unknown priority
/// and ordinary (not marker-only) work. Does not change the fixed TileState ABI.
struct DesignationDetail {
  tile_index:uint16;
  priority:uint8; // 0 unknown, 1 highest .. 7 lowest
  marker:bool; // planned only: DF occupancy.dig_marked
}

/// One 16x16 block of tiles at z level `bz`. Coordinates are in block
/// units (tile x = bx*16 + local x). `tiles` holds exactly 256 entries in
/// row-major order (local y outer, local x inner). Tiles in a partial edge
/// block that fall outside `Snapshot.map_size` are padding and ignored.
struct MapIndicator {
  tile_index:uint16;
  track:uint8; // N=1, S=2, E=4, W=8; pending carve-track occupancy
  traffic:uint8; // DF Normal=0, Low=1, High=2, Restricted=3
  warnings:uint8; // damp=1, warm=2; known mining warning facts
  completed_track:uint8; // N=1,S=2,E=4,W=8 from finished native TRACK tiletype; independent of pending carve
}

/// Native tile environment, independent of presentation or building room extents.
struct TileEnvironment {
  tile_index:uint16;
  flags:uint8; // subterranean=1, walkable brook surface=2, root tissue=4; no other bits
  building_occupancy:uint8; // native tile occupancy class, 0..7
}

table MapBlock {
  bx: int32;
  by: int32;
  bz: int32;
  tiles: [TileState];
  designation_details:[DesignationDetail];
  indicators:[MapIndicator];
  track_clearance_blocked:[uint16]; // sparse tile indices; occupancy blocks ramp traversal
  track_horizontal_blocked:[uint16]; // occupancy blocks candidate tile traversal
  track_support:[uint16]; // native wall/fortification supports ramps, independent of render shape
  track_open:[uint16]; // native OpenSpace/Chasm/EeriePit above ascending ramps
  environment:[TileEnvironment];
}

/// What `Snapshot.blocks` covers. Consumers apply blocks by upserting on
/// (bx, by, bz) regardless of scope; the scope tells them what is absent.
enum TerrainScope : uint8 {
  /// No terrain information in this snapshot (units-only).
  None = 0,
  /// `blocks` holds only blocks changed since the previous snapshot in the
  /// stream. Invalid before any Full has been seen in the stream.
  Delta,
  /// `blocks` holds every block of the map (the base state).
  Full,
}

// --- Unit appearance references ---
// How DF draws a unit, as DF resolved it: an ordered stack of tile-page
// regions (bottom first), each optionally recoloured through a palette row.
// Everything is a reference into the install's graphics raws; layer 4
// resolves tile page tokens through its raw index and palette files
// relative to the install root. Pixels never cross the mirror.

/// One drawn layer (16 bytes). A large image spans `cells_x` x `cells_y`
/// tiles starting at (tile_x, tile_y) on the page.
struct AppearanceLayer {
  /// Index into `Snapshot.tile_pages` (a TILE_PAGE token, e.g. "DWARF_BODY").
  page: uint16;
  tile_x: uint16;
  tile_y: uint16;
  cells_x: uint8;
  cells_y: uint8;
  /// Index into `Snapshot.palettes`; 0xFFFF = drawn as-is (no recolour).
  palette: uint16;
  /// Row of the palette file whose colours replace the key colours; -1
  /// when `palette` is none.
  palette_row: int16;
  /// Row of the palette file the art is painted in (its key colours;
  /// LS_PALETTE_DEFAULT); -1 when `palette` is none.
  palette_key_row: int16;
  /// Pixel offset of this layer within the unit's image (LG_OFFSET).
  offset_x: int8;
  offset_y: int8;
}

/// The appearance of one unit. `version` changes whenever the layer stack
/// changes (a hash of the layers); consumers keep the latest per unit.
/// An empty `layers` means DF has no graphics for the unit.
table UnitAppearance {
  unit: uint64;
  version: uint32;
  layers: [AppearanceLayer];
}

/// What `Snapshot.appearances` covers.
enum AppearanceScope : uint8 {
  /// No appearance information in this snapshot.
  None = 0,
  /// Only units whose appearance changed since their last publication,
  /// plus a rotating refresh slice (so a late-attaching consumer converges
  /// within one refresh period). Consumers upsert per unit.
  Delta,
  /// Every unit in `units` has an entry.
  Full,
}

// --- Buildings and map items ---
// Both tables are keyed by DF's own ids and streamed incrementally with a
// shared ChangeScope (Full = every entity present, Delta = changed or new
// entities plus `removed_*` ids, None = nothing about this table in the
// snapshot). Consumers upsert by id regardless of scope; a Delta before any
// Full is invalid (stream rule, like terrain). All enums are append-only.

/// What a table of entities covers in this snapshot.
enum ChangeScope : uint8 {
  None = 0,
  /// Only entities changed or new since the previous snapshot in the
  /// stream, plus a `removed_*` id list. Invalid before any Full.
  Delta,
  /// Every entity present; anything a consumer holds that is absent here
  /// no longer exists.
  Full,
}

/// Mirrors DF's `building_type` (df-structures), same order, offset by one
/// so 0 is Unknown, with pending Construction appended to preserve existing values.
/// Completed constructions remain terrain; pending jobs are building entities.
enum BuildingKind : uint8 {
  Unknown = 0,
  Chair,           // building_chairst
  Bed,             // building_bedst
  Table,           // building_tablest
  Coffin,          // building_coffinst
  FarmPlot,        // building_farmplotst
  Furnace,         // building_furnacest    subtype = furnace_type
  TradeDepot,      // building_tradedepotst
  Shop,            // building_shopst       subtype = shop_type
  Door,            // building_doorst
  Floodgate,       // building_floodgatest
  Box,             // building_boxst (chest / coffer / bag)
  Weaponrack,      // building_weaponrackst
  Armorstand,      // building_armorstandst
  Workshop,        // building_workshopst   subtype = workshop_type
  Cabinet,         // building_cabinetst
  Statue,          // building_statuest
  WindowGlass,     // building_window_glassst
  WindowGem,       // building_window_gemst
  Well,            // building_wellst
  Bridge,          // building_bridgest
  RoadDirt,        // building_road_dirtst
  RoadPaved,       // building_road_pavedst
  SiegeEngine,     // building_siegeenginest subtype = siegeengine_type
  Trap,            // building_trapst       subtype = trap_type
  AnimalTrap,      // building_animaltrapst
  Support,         // building_supportst
  ArcheryTarget,   // building_archerytargetst
  Chain,           // building_chainst (restraint)
  Cage,            // building_cagest
  Stockpile,       // building_stockpilest
  Civzone,         // building_civzonest    subtype = civzone_type
  Weapon,          // building_weaponst (upright spear / spike)
  Wagon,           // building_wagonst
  ScrewPump,       // building_screw_pumpst
  Hatch,           // building_hatchst
  GrateWall,       // building_grate_wallst
  GrateFloor,      // building_grate_floorst
  BarsVertical,    // building_bars_verticalst
  BarsFloor,       // building_bars_floorst
  GearAssembly,    // building_gear_assemblyst
  AxleHorizontal,  // building_axle_horizontalst
  AxleVertical,    // building_axle_verticalst
  WaterWheel,      // building_water_wheelst
  Windmill,        // building_windmillst
  TractionBench,   // building_traction_benchst
  Slab,            // building_slabst
  Nest,            // building_nestst
  NestBox,         // building_nest_boxst
  Hive,            // building_hivest
  Rollers,         // building_rollersst
  Instrument,      // building_instrumentst
  Bookcase,        // building_bookcasest
  DisplayFurniture,// building_display_furniturest
  OfferingPlace,   // building_offering_placest
  Construction,   // pending building_constructionst; subtype = construction_type
}

/// Construction state of a building.
enum BuildingStage : uint8 {
  /// Designated, no work done yet.
  Planned = 0,
  /// Some construction stages done (DF `getBuildStage() > 0`) but not all.
  InProgress,
  /// DF `getBuildStage() == getMaxBuildStage()`.
  Complete,
}

/// Per-building flags (bitfield). Kept small on purpose.
enum BuildingFlags : uint8 (bit_flags) {
  Forbidden,       // DF `flags.forbid`
  RoomAssigned,    // DF: the building owns / belongs to an assigned room
}

// Semantic subject of an artwork, independent of the renderer's chosen sprite.
enum ArtSubject : uint8 { Unknown, Shape, Item, Creature, Tree, Plant, Event }
enum ArtEvent : uint8 { Unknown, Generic, Duel, Triumph, Civilized, StrikeDown, Shot, ItemCreation, Battle, Site }
table StatueFacts {
  quality: int8 = -1; // DF quality 0..5, 6 artifact; -1 unknown.
  subject: ArtSubject = Unknown;
  subject_raw: string;
  caste_raw: string;
  event: ArtEvent = Unknown;
}

// Native bed choices, independent of texture/cache identifiers.
// Absent table means unknown (including recordings made before this field).
table BridgeState {
  direction:int8 = -2; // -1 retracting, 0 west, 1 east, 2 north, 3 south
  raised:bool;
  raising:bool;
  lowering:bool;
  collapsing:bool;
}

table BeddingFacts {
  sheet: int8 = -1;
  pillow: int8 = -1;
  base_color: string;
  sheet_color: string;
}

/// One DF building: a rectangle at one z, optionally masked by `extents`.
table Building {
  /// DF `building.id`.
  id: uint32;
  kind: BuildingKind = Unknown;
  /// DF per-kind subtype index: `workshop_type` for Workshop, `furnace_type`
  /// for Furnace, `trap_type` for Trap, `siegeengine_type` for SiegeEngine,
  /// `shop_type` for Shop, `civzone_type` for Civzone, `construction_type` for
  /// pending Construction; 0xFFFF for kinds
  /// without one (`kNoSubtype`).
  subtype: uint16 = 65535;
  /// Raw id of a custom workshop / furnace (`building_def.code`, e.g.
  /// "SOAP_MAKER") when subtype is the kind's Custom value; else empty.
  custom: string;
  /// Inclusive bounding rectangle at one z level (DF x1/y1/x2/y2/z).
  x1: int32;
  y1: int32;
  x2: int32;
  y2: int32;
  z: int32;
  /// DF `centerx` / `centery`; inside the rectangle.
  center_x: int32;
  center_y: int32;
  /// Optional per-tile occupancy, row-major over the rectangle (y outer),
  /// exactly (x2-x1+1)*(y2-y1+1) bytes of 0 / 1 when present; empty = the
  /// whole rectangle is occupied. DF `room.extents` for stockpiles, zones,
  /// farm plots and other free-form buildings.
  extents: [uint8];
  /// Index into `Snapshot.materials` (shared with terrain); 0xFFFF = none.
  material: uint16 = 65535;
  stage: BuildingStage = Complete;
  flags: BuildingFlags = 0;
  statue: StatueFacts;
  bedding: BeddingFacts;
  bridge: BridgeState;
  pump_direction:int8 = -1; // unknown; intake from north/east/south/west = 0/1/2/3
  pump_running:int8 = -1; // unknown; 0 idle, 1 active (native pump energy is nonzero)
  /// Construction component facts for supported artwork. Layouts prefer first PERM, else entry zero; other supported families use entry zero.
  construction_item_is_log:int8 = -1; // unknown/absent=-1, non-log=0, log=1
  construction_item_material:uint16 = 65535; // actual material; unknown=65535
  roller_direction:int8 = -1; // unknown; native direction 0..3
  roller_machine_position:int16 = -129; // unknown; native signed byte, 0 without linked machine
  instrument_family:int8 = -1; // unknown; keyboard/stringed/wind/percussion = 0/1/2/3
  instrument_placed:int8 = -1; // unknown; definition is portable=0, placed=1
  waterwheel_machine_position:int16 = -129; // unknown; native signed byte, 0 without linked machine
  windmill_orient_x:int8 = -2; // unknown; native east-positive vector -1..1
  windmill_orient_y:int8 = -2; // unknown; native south-positive vector -1..1
  windmill_rotation:int16 = -129; // unknown; native signed byte
  gear_axle_machine_position:int16 = -129; // unknown; native signed byte, 0 without linked machine
  horizontal_axle_vertical:int8 = -1; // unknown; native is_vertical: 0 WE, 1 NS
  slab_engraving:int8 = -2; // unknown; native slab_engraving_type -1..26
  vertical_bars_connections:int8 = -1; // unknown; native adjacency N=1,S=2,W=4,E=8
  well_chain_is_metal:int8 = -1; // unknown=-1; no metal chain component=0, metal chain present=1
  material_solid_color:string; // Native descriptor token; absent in older recordings
  construction_item_id:int32 = -1; // Selected component for supported furniture/layouts; unknown/absent=-1
  construction_item_solid_color:string; // Its native solid descriptor token
  contained_item_count:int32 = -1; // Coffin/Armorstand/Weaponrack/SiegeEngine/Trap0..3 entries; unknown=-1
  construction_tool_raw:string; // Selected job tool while planned, first contained tool when complete
  construction_stage:int32 = -1; // Exact native getBuildStage(); unknown in older recordings
  siege_facing:int8 = -1; // Native eight-way facing; unknown=-1
  siege_fire_timer:int16 = -129; // Native signed-byte timer; unknown=-129
  trap_state:int16 = -129; // Native Trap0..4 fact; unknown=-129
  trap_ready_timeout:int32 = -32769; // Native Trap0..3 fact; unknown=-32769
  trap_fill_timer:int32 = -32769; // Native Trap0..3 fact; unknown=-32769
  trap_trigger_flags:int16 = -1; // Native Trap0..3 fact; unknown=-1
  weapon_count:int32 = -1; // Weapon/Trap4 WEAPON or TRAPCOMP entries; unknown=-1
  weapon_retracted:int8 = -1; // Weapon retracted flag; unknown=-1
  construction_weapon_raw:string; // First WEAPON/TRAPCOMP definition token, independent of role
}

/// Mirrors DF's `item_type` (df-structures), same order, offset by one so
/// 0 is Unknown. Comments give DF's token.
enum ItemKind : uint8 {
  Unknown = 0,
  Bar,               // BAR
  SmallGem,          // SMALLGEM
  Blocks,            // BLOCKS
  Rough,             // ROUGH
  Boulder,           // BOULDER
  Wood,              // WOOD (a log)
  Door,              // DOOR
  Floodgate,         // FLOODGATE
  Bed,               // BED
  Chair,             // CHAIR
  Chain,             // CHAIN
  Flask,             // FLASK
  Goblet,            // GOBLET
  Instrument,        // INSTRUMENT
  Toy,               // TOY
  Window,            // WINDOW
  Cage,              // CAGE
  Barrel,            // BARREL
  Bucket,            // BUCKET
  AnimalTrap,        // ANIMALTRAP
  Table,             // TABLE
  Coffin,            // COFFIN
  Statue,            // STATUE
  Corpse,            // CORPSE
  Weapon,            // WEAPON
  Armor,             // ARMOR
  Shoes,             // SHOES
  Shield,            // SHIELD
  Helm,              // HELM
  Gloves,            // GLOVES
  Box,               // BOX
  Bag,               // BAG
  Bin,               // BIN
  Armorstand,        // ARMORSTAND
  Weaponrack,        // WEAPONRACK
  Cabinet,           // CABINET
  Figurine,          // FIGURINE
  Amulet,            // AMULET
  Scepter,           // SCEPTER
  Ammo,              // AMMO
  Crown,             // CROWN
  Ring,              // RING
  Earring,           // EARRING
  Bracelet,          // BRACELET
  Gem,               // GEM
  Anvil,             // ANVIL
  CorpsePiece,       // CORPSEPIECE
  Remains,           // REMAINS
  Meat,              // MEAT
  Fish,              // FISH
  FishRaw,           // FISH_RAW
  Vermin,            // VERMIN
  Pet,               // PET
  Seeds,             // SEEDS
  Plant,             // PLANT
  SkinTanned,        // SKIN_TANNED
  PlantGrowth,       // PLANT_GROWTH
  Thread,            // THREAD
  Cloth,             // CLOTH
  Totem,             // TOTEM
  Pants,             // PANTS
  Backpack,          // BACKPACK
  Quiver,            // QUIVER
  CatapultParts,     // CATAPULTPARTS
  BallistaParts,     // BALLISTAPARTS
  SiegeAmmo,         // SIEGEAMMO
  BallistaArrowhead, // BALLISTAARROWHEAD
  TrapParts,         // TRAPPARTS
  TrapComp,          // TRAPCOMP
  Drink,             // DRINK
  PowderMisc,        // POWDER_MISC
  Cheese,            // CHEESE
  Food,              // FOOD
  LiquidMisc,        // LIQUID_MISC
  Coin,              // COIN
  Glob,              // GLOB
  Rock,              // ROCK
  PipeSection,       // PIPE_SECTION
  HatchCover,        // HATCH_COVER
  Grate,             // GRATE
  Quern,             // QUERN
  Millstone,         // MILLSTONE
  Splint,            // SPLINT
  Crutch,            // CRUTCH
  TractionBench,     // TRACTION_BENCH
  OrthopedicCast,    // ORTHOPEDIC_CAST
  Tool,              // TOOL
  Slab,              // SLAB
  Egg,               // EGG
  Book,              // BOOK
  Sheet,             // SHEET
  Branch,            // BRANCH
  BoltThrowerParts,  // BOLT_THROWER_PARTS (DF 53.x; appended)
}

/// Per-item flags (bitfield): DF `item.flags` bits of the same name.
enum ItemFlags : uint8 (bit_flags) {
  Forbidden,
  Dump,
  Melt,
  OnFire,
  Rotten,
  Artifact,
  /// DF `flags.spider_web`: a THREAD item that is a spider's web on the
  /// ground (v5).
  Web,
}

/// What a corpse or body-part item counts as: DF's
/// `item_body_component.corpse_flags` (`ITEM_BODY_COMPONENT_FLAG_*`) bit
/// for bit (v5). Only Corpse / CorpsePiece items carry any; 0 on
/// every other kind. A whole corpse with `Bone` and without `Rottable` has
/// rotted to a skeleton (derivation, verification PENDING).
enum CorpseFlags : uint16 (bit_flags) {
  Unbutchered,     // BUTCHERABLE
  Plant,           // COUNTS_AS_PLANT_MATERIAL
  Silk,
  Leather,         // skin
  Bone,
  Shell,
  Wood,
  Soap,
  Tooth,
  Horn,
  Pearl,
  Rottable,        // rottable tissue remains
  Skull,           // TOTEMABLE
  HairWool,        // COUNTS_AS_STRAND_TISSUE
  Yarn,
}

/// One item lying on a map tile (DF `flags.on_ground`): not in a unit's
/// inventory, a container or a building, except items on a stockpile's
/// floor, which are on the ground. Hauling removes it from the map;
/// dropping adds it.
table MapItem {
  /// DF `item.id`.
  id: uint32;
  kind: ItemKind = Unknown;
  /// DF `item.getSubtype()` (index into the itemdef list of the kind:
  /// itemdef_weaponst for Weapon, itemdef_armorst for Armor, ...); 0xFFFF
  /// for kinds without one.
  subtype: uint16 = 65535;
  /// The itemdef's raw id (e.g. "ITEM_WEAPON_PICK") when `subtype` is
  /// set; else empty.
  subtype_raw: string;
  /// Index into `Snapshot.materials` (shared with terrain); 0xFFFF = none.
  material: uint16 = 65535;
  /// Required in practice; validators reject items without a position.
  pos: TilePos;
  /// DF `stack_size`; >= 1.
  stack: uint32 = 1;
  flags: ItemFlags = 0;
  /// v5: what a Corpse / CorpsePiece counts as; 0 for every other kind.
  corpse_flags: CorpseFlags = 0;
  /// Native item_body_component.unit_id; -1 if unknown or not a body component.
  corpse_unit_id: int32 = -1;
  /// Direct CONTAINS_ITEM references, in native order. UINT_MAX means unknown
  /// (including older recordings); zero is an observed empty container.
  contained_count: uint32 = 4294967295;
  /// Kind/material/itemdef of the first valid directly contained item.
  contained_kind: ItemKind = Unknown;
  contained_material: uint16 = 65535;
  contained_subtype_raw: string;
  statue: StatueFacts;
  /// Observed first-item color descriptor, including dye; absent = unknown.
  contained_color: string;
  bedding: BeddingFacts;
}


// --- Corpse appearance references and classic glyphs ---

/// The appearance of one map item, as DF resolved it (today: items of
/// kind Corpse and CorpsePiece, through the creature's CORPSE layer set
/// or simple CORPSE sprite, or the hardcoded body-part tiles). Same layer
/// vocabulary and tables (`tile_pages`, `palettes`) as UnitAppearance;
/// `version` is the stack hash. An empty `layers` means DF has no
/// page-resolvable art for the item.
table ItemAppearance {
  /// DF item id; must name an item present in `items` of this snapshot.
  item: uint32;
  version: uint32;
  layers: [AppearanceLayer];
}

/// A classic (CP437 / curses) glyph as DF's raws define it: the tile's
/// code point and DF's colour triple (foreground 0..7, background 0..7,
/// bright 0/1). 4 bytes.
struct Glyph {
  tile: uint8;
  fg: uint8;
  bg: uint8;
  bright: uint8;
}

/// Classic glyph of a creature: `[CREATURE_TILE]` + `[COLOR:f:b:br]` of the
/// creature raw (caste overrides are not carried).
table CreatureGlyph {
  /// Creature raw identifier, as `UnitState.species`.
  species: string;
  glyph: Glyph;
  /// `[SOLDIER_TILE]` when set, else the same as `glyph.tile`.
  soldier_tile: uint8;
}

/// Classic glyph data of a material: `[TILE]` (the tile of boulders /
/// walls of the material), `[ITEM_SYMBOL]` (gems), `[BASIC_COLOR:fg:br]`
/// (items made of it), `[BUILD_COLOR]` and `[TILE_COLOR]` (constructions
/// and tiles), as df-structures exposes them. Measured against the raws
/// (DF 53.16): `tile_color` is `[DISPLAY_COLOR:fg:bg:br]`
/// verbatim, `basic_fg` / `basic_bright` are DISPLAY_COLOR's fg and br
/// (the colour of an item of the material on a black cell), and `build`
/// is `[BUILD_COLOR]` when the raw gives one, else DF's default derived
/// from DISPLAY_COLOR (granite 7:0:0 -> 0:7:0).
table MaterialGlyph {
  /// Raw material identifier, the same string as in `Snapshot.materials`.
  material: string;
  tile: uint8;
  item_symbol: uint8;
  basic_fg: uint8;
  basic_bright: uint8;
  build: Glyph;
  tile_color: Glyph;
}

/// Classic tile of an itemdef that carries one (`[TILE]` on tools).
table ItemDefGlyph {
  kind: ItemKind = Unknown;
  /// The itemdef's raw id, as `MapItem.subtype_raw`.
  subtype_raw: string;
  tile: uint8;
}

/// Per-tick snapshot. Units are full-state every snapshot; terrain is
/// incremental via `terrain_scope`; appearances are incremental via
/// `appearance_scope` (v3);
/// buildings and map items via `building_scope` / `item_scope` (v4).
/// Confirmed combat outcomes, retained briefly to survive skipped snapshots.
enum CombatEventKind : uint8 { Wound = 1, Death = 2 }
/// Item identity sampled at the source event, including carried items absent
/// from the ground-item stream. Raw semantic identifiers, not presentation cues.
table EventItem {
  id: int32 = -1;
  type: string;
  subtype_raw: string;
  material: string;
  material_flags: uint32;
  material_flags_known: bool;
  melee_skill: string;
}

/// Positive physical impact between two identified items. Pair order does not
/// imply attacker/defender roles. Intent, proximity and inferred pairs excluded.
table ItemContactEvent {
  id: uint64;
  tick: uint64;
  first: EventItem (required);
  second: EventItem (required);
  pos: TilePos;
}
/// Exact equipment contact within one native melee execution.
table AttackContact {
  first: EventItem (required);
  second: EventItem (required);
}
// Stable semantic masks, deliberately independent of native bit positions.
enum AttackDamageFlag:uint32 (bit_flags) {
  Cut, Smashed, SmashedApart, Broken, Gouged, CompoundFracture,
  MotorNerveSevered, SensoryNerveSevered, MajorArtery, GutsSpilled
}
enum AttackAnatomyFlag:uint32 (bit_flags) { Head, Thought, Circulation, Throat, Internal }
table AttackWoundPart {
  body_part_id: int32 = -1;
  layer_id: int32 = -1;
  body_part_token: string;
  body_part_category: string;
  damage_flags: uint32;
  anatomy_flags: uint32;
}
table AttackWound {
  wound_id: int32 = -1;
  victim_id: int32 = -1;
  severed_part: bool;
  popped_out: bool;
  parts: [AttackWoundPart];
  parts_complete: bool;
}

/// Published after execution returns; empty results are not a proven miss.
/// Each completeness flag covers only its named observation channel.
enum ProjectileCombatKind:uint8 { Unknown, Release, HitCreature, Blocked, GroundImpact }
enum WeaponLauncher:uint8 { Unknown, Bow, Crossbow, Ballista }
table ProjectileCombatEvent {
  id:uint64;
  tick:uint64;
  projectile_id:int32;
  source_unit_id:int32 = -1;
  target_unit_id:int32 = -1;
  kind:ProjectileCombatKind;
  launcher:WeaponLauncher;
  ammunition:EventItem;
  weapon:EventItem;
  pos:TilePos;
  context_complete:bool;
}

enum AttackOutcome:uint8 { Unknown, Miss, Hit, Blocked, ParrySuccess, ParryFailed, Wrestle }
table ResolvedAttack {
  id: uint64;
  tick: uint64;
  attacker_id: int32 = -1;
  defender_id: int32 = -1;
  action_id: int32 = -1;
  weapon: EventItem;
  pos: TilePos;
  contacts: [AttackContact];
  equipment_contacts_complete: bool;
  wounds: [AttackWound];
  wounds_complete: bool;
  outcome: AttackOutcome = Unknown;
  outcome_complete: bool;
  weapon_context_complete: bool;
}

table CombatEvent {
  id: uint64;
  tick: uint64;
  kind: CombatEventKind = Wound;
  attacker_id: int32 = -1;
  victim_id: int32 = -1;
  wound_id: int32 = -1;
  pos: TilePos;
  report_id: int32 = -1;
  /// Context only: exactly one matching recovering melee action was observed.
  /// This is not proof that this action/weapon caused this particular wound.
  source_action_id: int32 = -1;
  weapon: EventItem;
}

/// Observed projectile samples, not inferred ballistic trajectories.
table ProjectileSample {
  sequence: uint64;
  projectile_id: uint64;
  tick: uint64;
  item_id: int32 = -1;
  firer_id: int32 = -1;
  pos: TilePos;
  previous: TilePos;
  origin: TilePos;
  target: TilePos;
  active: bool = true;
  first_observed: bool = false;
  ammunition: EventItem;
  launcher: EventItem;
}

/// Newly created native report. Its token is authoritative; tokens such as
/// COMBAT_PARRY do not themselves distinguish a successful/failed defense.
/// Continuation lines and updates to repeat_count are not additional events.
table ReportEvent {
  id: uint64;
  tick: uint64;
  report_id: int32 = -1;
  type: string;
  pos: TilePos;
  pos2: TilePos;
  repeat_count: uint32;
  speaker_id: int32 = -1;
}

/// Native material contamination on one tile. Amount is DF's 1..255 value,
/// independent of liquid depth. No record means the material is absent.
enum MatterState : uint8 { Solid = 0, Liquid, Gas, Powder, Paste, Pressed }
struct GroundSpatter {
  tile: uint8; // row-major local y*16+x
  amount: uint8;
  material: uint16;
  state: MatterState;
}
/// Complete replacement for the listed block, including empty removal records.
table SpatterBlock {
  bx: int32;
  by: int32;
  bz: int32;
  entries: [GroundSpatter];
}

table Snapshot {
  schema_version: uint32;
  /// DF simulation tick this snapshot was captured at (a safe point).
  tick: uint64;
  /// Bridge wall clock when the snapshot was published (unix milliseconds).
  /// Transport metadata: lets recorded fixtures replay with realistic
  /// arrival timing. Not simulation state.
  emitted_at_ms: uint64;
  /// Exclusive upper bound for tile positions; all components positive.
  map_size: TilePos;
  units: [UnitState];
  terrain_scope: TerrainScope = None;
  blocks: [MapBlock];
  /// Per-snapshot string table of raw material identifiers referenced by
  /// `TileState.material`, `Building.material` and `MapItem.material`.
  /// Opaque semantic strings; indices are scoped to this snapshot only (a
  /// Delta carries its own table). Since v4 it may be present with
  /// terrain_scope None (buildings / items reference it too).
  materials: [string];
  appearance_scope: AppearanceScope = None;
  /// Every entry names a unit present in `units` (referential integrity);
  /// at most one entry per unit.
  appearances: [UnitAppearance];
  /// Per-snapshot table of tile page tokens referenced by
  /// `AppearanceLayer.page` (TILE_PAGE names from the install's graphics
  /// raws). Indices are scoped to this snapshot only.
  tile_pages: [string];
  /// Per-snapshot table of palette files referenced by
  /// `AppearanceLayer.palette`: paths relative to the DF install root with
  /// forward slashes (e.g. "data/vanilla/vanilla_creatures_graphics/
  /// graphics/images/dwarf/dwarf_body_palettes.png"). Never absolute.
  palettes: [string];
  building_scope: ChangeScope = None;
  /// Buildings present (Full) or changed / new (Delta); ids unique.
  buildings: [Building];
  /// Ids of buildings that ceased to exist since the previous snapshot
  /// (Delta); none of them may also appear in `buildings`.
  removed_buildings: [uint32];
  item_scope: ChangeScope = None;
  /// Map items present (Full) or changed / new / moved (Delta); ids unique.
  items: [MapItem];
  /// Ids of items that left the map since the previous snapshot (Delta);
  /// none of them may also appear in `items`.
  removed_items: [uint32];
  /// What `item_appearances` covers: None = no entries; Delta = entries
  /// for some of the items in `items` (changed stacks travel with their
  /// item record); Full = additionally every Corpse / CorpsePiece item in
  /// `items` has exactly one entry (meaningful with item_scope Full).
  item_appearance_scope: AppearanceScope = None;
  /// Every entry names an item present in `items`; at most one per item.
  /// Layers index the same `tile_pages` / `palettes` tables as unit
  /// appearances.
  item_appearances: [ItemAppearance];
  /// Classic glyph tables: None = nothing here; Delta = entries new or
  /// changed since the previous snapshot (consumers upsert by key); Full =
  /// every entry the bridge knows (creature raws, interned materials,
  /// itemdefs with a tile). Keys unique within a snapshot.
  glyph_scope: ChangeScope = None;
  creature_glyphs: [CreatureGlyph];
  material_glyphs: [MaterialGlyph];
  itemdef_glyphs: [ItemDefGlyph];
  /// Outcomes of commands the bridge executed since it last published.
  /// Each result is re-sent for a few consecutive snapshots so a
  /// slow-polling client does not miss it; consumers keep the first
  /// arrival per `seq` and ignore repeats. Unique `seq` per snapshot.
  command_results: [CommandResult];
  /// Strictly increasing session-local ids; at most 256
  /// observations from the last 600 ticks. Victims may already be departed.
  combat_events: [CombatEvent];
  /// At most 512 samples retained for 120 ticks.
  projectile_samples: [ProjectileSample];
  /// Full lists every contaminated block; absent blocks
  /// are clean. Delta replaces only listed blocks. None conveys no change.
  spatter_scope: ChangeScope = None;
  spatters: [SpatterBlock];
  /// 512 reports / 600 ticks, session-local increasing
  /// event IDs. Missing positions are valid for nonspatial announcements.
  report_events: [ReportEvent];
  /// Session-cumulative source records evicted by the capacity limit, not age.
  report_events_dropped: uint64;
  /// Positive item impacts, 512 records / 600 ticks.
  item_contacts: [ItemContactEvent];
  item_contacts_dropped: uint64;
  item_contacts_available: bool;
  resolved_attacks: [ResolvedAttack];
  resolved_attacks_dropped: uint64;
  resolved_attacks_available: bool;
  projectile_combat_events:[ProjectileCombatEvent];
  projectile_combat_events_dropped:uint64;
  projectile_combat_events_available:bool;
  /// Fortress calendar position within the year; -1 means unavailable.
  calendar_year_tick:int32 = -1;
}

// --- Command path (presentation → bridge) ---
// Commands are semantic intents: defined here at the mirror
// layer, produced by presentations, executed by the bridge. No
// presentation-specific command types.

table SetPause {
  paused: bool;
}

/// An inclusive tile rectangle on one z level, in map tile coordinates
/// (0 <= x1 <= x2 < map_size.x, same for y, 0 <= z < map_size.z).
struct TileRect {
  x1: int32;
  y1: int32;
  x2: int32;
  y2: int32;
  z: int32;
}

/// What a dig designation asks for. Maps onto DF's `tile_dig_designation`
/// (Default / Channel / Ramp / UpStair / DownStair / UpDownStair / No).
enum DigKind : uint8 {
  Dig = 0,       // mine out a wall; removing ramps/stairs is a separate operation
  Channel,
  RampUp,
  StairsUp,
  StairsDown,
  StairsUpDown,
  Remove, // clear orders
  RemoveStairsRamps,
  Activate,
  Mark,
  StairsSpan,
}

/// Designate every diggable tile of `rect` (v6). Tiles DF would not
/// accept (open air, constructions, map edge, floors for anything but
/// channel / down stairs) are skipped; the result reports how many were
/// applied and is Rejected when none were.
table DesignateDig {
  rect: TileRect;
  kind: DigKind = Dig;
  /// DF work priority 1 (highest) .. 7 (lowest); DF's default is 4.
  priority: uint8 = 4;
  marker: bool = false;
  mining_mode: uint8 = 0; // All, Auto, OreGems, Gems
  max_z: int32 = -1; // inclusive upper layer; -1 means rect.z
}

enum SmoothKind : uint8 {
  Smooth = 0,
  Engrave,
  Remove,        // clear any smooth / engrave designation
  Fortify,
  Track,
}

/// Designate natural stone walls and floors of `rect` for smoothing /
/// engraving (v6). Engrave applies to tiles already smoothed.
table DesignateSmooth {
  rect: TileRect;
  kind: SmoothKind = Smooth;
  priority: uint8 = 4;
  marker: bool = false;
  from_east: bool = false;
  from_south: bool = false;
  max_z: int32 = -1;
  track_end_z: int32 = -1; // Track destination layer; rect.z is the press/start layer
}

/// Mark (or unmark) every tree whose designation tile lies in `rect` for
/// felling (v6). DF stores this as a `Default` dig designation on the
/// tree's south-east trunk tile.
table DesignateChop {
  rect: TileRect;
  enable: bool = true;
  priority: uint8 = 4;
  marker: bool = false;
  max_z: int32 = -1;
}

/// Mark (or unmark) every shrub in `rect` for plant gathering (v6): a
/// `Default` dig designation on the shrub's tile.
table DesignateGather {
  rect: TileRect;
  enable: bool = true;
  priority: uint8 = 4;
  marker: bool = false;
  max_z: int32 = -1;
}

/// A tri-state flag change: leave as is, set, or clear.
enum OptionalBool : uint8 {
  Unchanged = 0,
  Set,
  Clear,
}

/// Change an item's player flags (v6): DF `item.flags.forbid`, `dump`,
/// `melt`. Melt is Rejected on an item DF cannot melt (non-metal,
/// artifact, bar).
table SetItemFlags {
  /// DF `item.id`; never 0.
  item: uint32;
  forbidden: OptionalBool = Unchanged;
  dump: OptionalBool = Unchanged;
  melt: OptionalBool = Unchanged;
}

/// Change a building's player flags (v6). DF has exactly one: the
/// forbid bit of doors and hatches (`door_flags.forbidden`); any
/// other kind is Rejected.
table SetBuildingFlags {
  /// DF `building.id`; never 0.
  building: uint32;
  forbidden: OptionalBool = Unchanged;
}

union CommandPayload {
  SetPause,
  DesignateDig,
  DesignateSmooth,
  DesignateChop,
  DesignateGather,
  SetItemFlags,
  SetBuildingFlags,
}

table Command {
  /// Client-assigned, strictly increasing per session; the bridge echoes it
  /// in `CommandResult.seq`.
  seq: uint64;
  payload: CommandPayload;
  world_epoch:uint64; // originating presented model; zero/old epochs are rejected by bridge
}

/// Outcome of one command, echoed in `Snapshot.command_results`.
enum CommandStatus : uint8 {
  /// Executed; `message` may carry a summary ("9 of 9 tiles").
  Ok = 0,
  /// Not executed (malformed, out of the map, nothing applicable, an
  /// unknown id, a flag DF does not allow); `message` says why.
  Rejected,
  /// The bridge does not understand the payload (a newer schema).
  Unknown,
}

table CommandResult {
  seq: uint64;
  status: CommandStatus = Ok;
  message: string;
}

enum SessionPhase : uint8 { Starting, Menu, Loading, Ready, Unavailable, Error, Saving, Unloading }
enum SessionAction : uint8 { LoadFortress, SaveContinue, SaveReturn, AcknowledgeAnnouncement, ReviewPetition, ApprovePetition, DenyPetition, ClosePetition, ReadSaveDestinations, QuitWithoutSaving }
enum SaveReturnMode : uint8 { None, ExistingDestination, NewFolder, NewTimeline }
table SaveDestination { id:string (required); folder:string (required); }
// A complete, request-scoped catalog. Absence is unavailable, not zero choices.
table SaveDestinationCatalog { receipt:uint64; fortress_epoch:uint64; destinations:[SaveDestination] (required); }
enum InterruptionKind : uint8 { None, ManualPause, PassiveAnnouncement, AnnouncementViewer, Diplomacy, Petition, Trade, OtherDecision }
table InterruptionState { kind:InterruptionKind; receipt:uint64; text:string; reason:string; popup_count:uint32; can_acknowledge:bool; }
table PetitionReviewState { id:int32 = -1; receipt:uint64; can_review:bool; can_respond:bool; can_close:bool; reason:string; agreement:AgreementInfo; guildhall_value:int32; grand_guildhall_value:int32; }
enum LoadRequestStatus : uint8 { None, Pending, Ok, Rejected, UnknownOutcome }
table FortressSave { id:string (required); fort_name:string; world_name:string; year:int32; }
// Fortress-wide values, independent of the subscribed map window.
// Stress counts are ordered from highest stress to lowest (seven DF categories).
table FortressSummary {
  population:int32;
  stress_counts:[uint32];
  stress_available:bool;
  elevation_offset:int32;
  level_count:uint32;
  // Cached fortress resources: total food, drink, seeds, meat, fish, plant, other.
  resource_counts:[int32];
  resources_available:bool;
  // Achieved native record precision, not the requested nobles setting.
  // Older snapshots omit it; -1 is unknown and must not imply lowest precision.
  bookkeeper_precision:int32 = -1;
}
// Active fortress notifications, in native presentation-independent group order.
enum NotificationCategory : uint8 { General, EraChange, Underground, Migrant, Monster, Ambush, Trade, Noble, Animal, Birth, Mood, LaborChange, Military, Marriage, Berserk, MartialTrance, LoseEmotion, Stress, ArtDefacement, Masterpiece, JobFailed, Death, Ghost, UndeadAttack, Weather, Vermin, CuriousGuzzler, ResearchBreakthrough, GuestArrival, Holdings, Rumor, Agreement, Crime, DeityCurse, Combat, Sparring, Hunting }
enum UnitReportCategory : uint8 { Combat, Sparring, Hunting }
table UnitReportReference { unit_id:int32; category:UnitReportCategory; }
table ActiveNotificationGroup {
  category:NotificationCategory;
  report_ids:[int32] (required);
  report_count:uint32;
  unit_reports:[UnitReportReference] (required);
  unit_report_count:uint32;
  complete:bool = true;
}
table SessionState {
  schema_version:uint32 = 12;
  revision:uint64;
  phase:SessionPhase;
  saves:[FortressSave];
  active_save_id:string;
  request_seq:uint64;
  request_status:LoadRequestStatus;
  message:string;
  request_action:SessionAction;
  fortress_valid:bool;
  paused:bool;
  year:int32;
  year_tick:int32;
  fort_name:string;
  can_save:bool;
  can_save_return:bool;
  // Durable destination of the matching successful save, including after unload.
  saved_save_id:string;
  fortress_epoch:uint64;
  interruption:InterruptionState;
  petition:PetitionReviewState;
  fortress_summary:FortressSummary;
  active_notifications:[ActiveNotificationGroup];
  active_notifications_complete:bool = true;
  request_client_id:uint64;
  request_fortress_epoch:uint64;
  save_destinations:SaveDestinationCatalog;
  alert_button_report_ids:[int32]; alert_button_report_count:uint32; alert_button_complete:bool = true;
  fort_original_name:string;
  fortress_rank:int16 = -1;
  fortress_capital:bool;
  moon_phase:int8 = -1;
}
// IDs are opaque handles from the current advertised list, never filesystem commands.
table SessionCommand {
  schema_version:uint32 = 12; seq:uint64; save_id:string; action:SessionAction;
  checkpoint_name:string; fortress_epoch:uint64; interruption_receipt:uint64;
  petition_id:int32 = -1; petition_receipt:uint64; client_id:uint64;
  save_catalog_receipt:uint64;
  save_return_mode:SaveReturnMode;
  save_destination_id:string;
  // Native metadata bytes, not a filesystem path or UTF-8-normalized caption.
  timeline_name:[uint8];
}

// Bounded fortress management channel; independently versioned from map snapshots.
enum ManagementAction : uint8 { Catalog, Preview, Place, Inspect, Remove, InspectAtTile, RemoveConstruction, AreaCatalog, AreaInspectAtTile, AreaInspect, AreaCreate, AreaUpdate, AreaDelete, AreaLink, AreaCandidates, ProductionList, ProductionInspect, ProductionQueue, ProductionJobEdit, FarmEdit, WorkOrderList, WorkOrderInspect, WorkOrderCreate, WorkOrderUpdate, WorkOrderDelete, WorkOrderCondition, WorkOrderCandidates, WorkOrderCatalog, CitizenList, CitizenInspect, WorkDetailList, WorkDetailInspect, WorkDetailMembership, WorkDetailMode, ReportList, ReportInspect, AgreementList, AgreementInspect, TradeList, TradeInspect, TradeUpdate, TradeGoods, TradeBring, TradeExchangeOpen, TradeExchangeInspect, TradeExchangeSelect, TradeExchangeSubmit, TradeExchangeClose, StocksOpen, StocksList, StocksInspect, StocksClose, AppointmentsOpen, AppointmentsCandidates, AppointmentsAssign, AppointmentsBack, KitchenOpen, KitchenList, KitchenSetPermission, KitchenClose, Alert, Selection, CreatureInspect, ConstructionMaterials, WorkDetailCreate, WorkDetailDelete, WorkDetailEdit, CitizenWorkScope, PrepareAlertDismissal, DismissAlert, WorldHover, CreatureHeaderRead, CreatureHeaderEdit, CreatureLocate, CreatureExpelRead, CreatureExpelApply, CreatureKnowledgeRead, CreatureWorkshopRemove, CreatureLocationRemove, CreatureAnimalEdit, ResidentsQuery, ResidentsRowsRead, ResidentsSpecialize, CreatureSheetLocate, ResidentsActivityRead, JobSettingsRead, JobSettingsApply, WorkDetailWorkersQuery, WorkDetailRowsRead, WorkDetailSettingsRead, WorkDetailSettingsToggle, StandingOrdersRead, StandingOrdersSet, HunterAmmunitionRead, HunterAmmunitionCandidates, HunterAmmunitionApply, ChoresRead, ChoresApply, KitchenRead, KitchenApply, StoneUseRead, StoneUseApply, StocksMenuRead, StocksGroupApply, StocksItemApply, TasksRead, TasksApply, PlacesRead, PlacesApply, NoblesRead, NoblesCandidates, NoblesCommit }
enum AreaKind : uint8 { Stockpile, Zone, Workshop }
enum AreaOperation : uint8 { None, SettingsPage, SettingsSet, Preset, Rename, Paint, LocationList, LocationSet, LocationCreate, ZoneSettings, Links, AssignUnits, SquadUse, Toggles, CandidateList, WorkshopLink, MultiCreate, MultiUndo, MultiFinish, PaintCounts, LocationChoices, LocationDetails, LocationOpen, LocationAccess, LocationStaffCandidates, LocationStaffEdit, LinkTarget, LocationQuantity, LocationNameRead, LocationNameChoices, LocationNameEdit, LocationRecognitionRead, LocationRecognize, LocationReligiousStaffRead, LocationReligiousStaffRemove, LocationReligiousCandidates, LocationReligiousAssignmentRead, LocationReligiousAssign, LocationSpecializationRead, LocationSpecializationSet, LocationStaffAssignmentsRead }
enum LocationNameMode : uint8 { Clear, SelectWord, RandomComponent, RandomWhole }
enum LocationQuantityMode : uint8 { Set, Increase, Decrease }
enum LocationEntryOutcome : uint8 { None, Completed, Rejected, Stale, Unknown }
enum LocationEditOutcome : uint8 { None, Completed, Rejected, Stale, Unknown }
enum AreaRoomOutcome : uint8 { None, Completed, Rejected, Stale, Unknown }
struct AreaSpan { y:int16; x:int16; length:uint16; }
table AreaZoneSettings {
  pond_mode:uint8;
  facing:uint8;
  tomb_citizens:int8 = -1;
  tomb_pets:int8 = -1;
  gather_trees:int8 = -1;
  gather_shrubs:int8 = -1;
  gather_fallen:int8 = -1;
}
table AreaSettingRow { key:string; index:int32 = -1; label:string; kind:uint8; state:uint8; estimated:bool; }
table AreaLocationRow { id:int32 = -1; name:string; location_kind:uint8; religion:string; guild_profession:int16 = -1; location_tier:int32 = -1; site_id:int32 = -1; }
// Absent in legacy recordings: unavailable, not an empty native row.
// Installed palette components; effect0 steady,1 legendary,2 nemesis,3 fire.
table AreaNameColor { foreground:uint8; background:uint8; bright:uint8; alternate_foreground:uint8; alternate_background:uint8; alternate_bright:uint8; effect:uint8; }
table AreaOwnerDisplay { columns:uint16; first_line:string; second_line:string; status:string; room_value:int32; name_color:AreaNameColor; }
// Unknown preserves absent identity in older recordings; never infer a unit/item.
enum AreaCandidateEntity:uint8 { Unknown=0, Unit=1, Item=2, Squad=3 }
// Optional owned animal text facts; absent in older recordings.
table AreaAnimalDisplay { columns:uint16; first_line:string; second_line:string; combined_fits:bool; warning:string; name_color:AreaNameColor; }
// Status kind: none/pasture/pit/pond/item/missing-container. Containment: none/current-chain/current-cage/assigned-chain/assigned-cage.
table AreaAnimalItemColor { foreground:uint8; background:uint8; bright:uint8; }
// Saved squad insignia identity and colors; never native texture/cache handles.
table AreaSquadSymbol { index:uint8; foreground_r:uint8; foreground_g:uint8; foreground_b:uint8; background_r:uint8; background_g:uint8; background_b:uint8; }
table AreaAnimalRestraint { rope:bool; solid_color:string; }
table AreaAnimalContainer { material_family:uint8; solid_color:string; occupant_entity:uint8; occupant_id:int32 = -1; occupant:SelectionAppearance; }
table AreaAnimalStatus { kind:uint8; containment:uint8; item_id:int32 = -1; }
table AreaCandidateRow { id:int32 = -1; name:string; profession:string; sex:int8 = -1; mood:uint8; grazer:bool; assigned:bool; squad_use:int8 = -1; owner_display:AreaOwnerDisplay; sheet_icon:SelectionAppearance; entity:AreaCandidateEntity; animal_display:AreaAnimalDisplay; animal_status:AreaAnimalStatus; animal_container:AreaAnimalContainer; animal_restraint:AreaAnimalRestraint; animal_item_color:AreaAnimalItemColor; squad_symbol:AreaSquadSymbol; }
table AreaLinkRow { id:int32 = -1; kind:AreaKind; direction:uint8; name:string; }
table AreaPaintPreview { x:int16; y:int16; width:uint16; height:uint16; }
table AreaRequest {
  kind:AreaKind;
  id:int32 = -1;
  origin:TilePos;
  width:uint16 = 1;
  height:uint16 = 1;
  zone_type:int16 = -1;
  categories:uint32;
  changed_categories:uint32;
  barrels:int16 = -1;
  bins:int16 = -1;
  wheelbarrows:int16 = -1;
  links_only:int8 = -1;
  active:int8 = -1;
  owner_id:int32 = -2;
  link_id:int32 = -1;
  give:bool = true;
  unlink:bool;
  query:string;
  cursor:uint32;
  operation:AreaOperation;
  expected_revision:uint64;
  expected_list_revision:uint64;
  list_key:string;
  row_key:string;
  // SettingsSet:1 individual native leaf/scalar,2 native leaf All/None,
  // 3 category header,4 global header. v59 rejects legacy whole-page/category-row edits.
  scope:uint8;
  // SettingsSet uses1..2; LocationAccess uses0 Visitors,1 Residents,2 Citizens,3 Members.
  value:uint8;
  preset:uint8;
  name:string;
  spans:[AreaSpan];
  // 1 adds selected cells; 2 erases selected cells. Former replacement mode 3 is retired.
  paint_mode:uint8;
  paint_z:int16 = -1;
  location_id:int32 = -2;
  location_kind:uint8;
  profession:int16 = -1;
  deity_kind:int8 = -1;
  deity_id:int32 = -1;
  zone_settings:AreaZoneSettings;
  unit_id:int32 = -1;
  assign:int8 = -1;
  squad_id:int32 = -1;
  squad_use:int8 = -1;
  organic:int8 = -1;
  inorganic:int8 = -1;
  candidate_kind:uint8;
  sort:uint8;
  sort_descending:bool;
  // Multi selection uses origin/width/height. No room-count limit is implied by
  // the separately bounded AreaInfo reply page. 1 bed, 2 chair, 3 table, 4 coffin.
  room_furniture:uint8;
  interaction_id:uint64;
  undo_token:uint64;
  // PaintCounts reads local draft spans and an optional rectangle at paint_z.
  // Count generation belongs to the presentation; it is echoed without rounding.
  count_generation:uint64;
  paint_preview:AreaPaintPreview;
  location_site_id:int32 = -1;
  // StaffEdit requires Details expected_revision and candidate expected_list_revision.
  // unit_id >= 0 assigns; -1 removes. Replies carry LocationEditOutcome + refreshed Details.
  occupation_id:int32 = -1;
  // SettingsPage initial sublist only: retain native category-opening order.
  // Absent/false preserves explicit leaf-selection ordering in older records.
  category_opening:bool;
  // Owner CandidateList raw textbox bytes; absent uses legacy UTF-8 query.
  query_bytes:[uint8];
  // Owner CandidateList only: 0 retains the default128-row page, 1..128 bounds
  // returned facts without changing the cached list's identity or ordering.
  candidate_limit:uint16;
  // AssignUnits: exactly one of unit_id/item_id must be nonnegative.
  item_id:int32 = -1;
  // LocationQuantity only: supplies0..9, library copies10. Set uses0..999; steps use0.
  quantity_id:int8 = -1;
  quantity_mode:LocationQuantityMode;
  quantity_value:int32;
  name_query:LocationNameQuery;
  name_edit:LocationNameEdit;
  religious_entity_id:int32 = -1;
  religious_assignment_id:int32 = -1;
  religious_holder_id:int32 = -1;
}
table AreaInfo {
  id:int32;
  kind:AreaKind;
  name:string;
  origin:TilePos;
  width:uint16;
  height:uint16;
  extents:[uint8];
  zone_type:int16 = -1;
  categories:uint32;
  barrels:int16;
  bins:int16;
  wheelbarrows:int16;
  links_only:bool;
  active:bool;
  owner_id:int32 = -1;
  owner_name:string;
  owner_allowed:bool;
  gives:[int32];
  takes:[int32];
  revision:uint64;
  zone_label:string;
  location_id:int32 = -1;
  location_name:string;
  religion:string;
  organic:int8 = -1;
  inorganic:int8 = -1;
  zone_settings:AreaZoneSettings;
  tile_count:int32 = -1;
  assigned_count:int32 = -1;
  location_kind:uint8; // 0 unknown; same semantic kinds as AreaLocationRow
  owner_profession:string;
  owner_sex:int8 = -1;
  location_site_id:int32 = -1;
  storage_limit:int32 = -1; // Native stockpile container bound; -1 unavailable/legacy.
  custom_name:string; // Exact stored name, separate from the default display label.
  overlapping:int8 = -1; // Zone collision: -1 unknown/legacy, 0 clear, 1 overlapping.
}
table AreaChoice { id:int32; name:string; label:string; }
table LocationDeity { id:int32 = -1; name:string; spheres:[int32]; }
table LocationReligion { kind:uint8; id:int32 = -1; name:string; worshippers:int32; has_temple:bool; deities:[LocationDeity]; }
table LocationGuild { profession:int32 = -1; workers:int32; has_meeting_place:bool; guild_id:int32 = -1; guild_name:string; members:int32; }
table LocationCatalog {
  kind:uint8; revision:uint64; cursor:uint32; total:uint32; next_cursor:uint32;
  religions:[LocationReligion]; guilds:[LocationGuild];
}
table LocationSupplyQuantity { kind:uint8; stored:int32; desired:int32; }
// Verified core facts only. Raw value does not establish native UI visibility.
table LocationFacilities { chests:int32; beds:int32; tables:int32; traction_benches:int32; bookcases:int32; chairs:int32; rooms:int32; rented_rooms:int32; }
// Ordered native rows, including duplicate assignments. Absence means unobserved.
table LocationStaffNames {
  position_name:string; holder_name:string;
  holder_kind:uint8; holder_id:int32 = -1;
}
table LocationStaffRow {
  source:uint8; // 0 occupation, 1 religious position
  occupation_id:int32 = -1; role:int32 = -1; histfig_id:int32 = -1; unit_id:int32 = -1;
  location_id:int32 = -1; site_id:int32 = -1; group_id:int32 = -1;
  entity_id:int32 = -1; position_id:int32 = -1; assignment_id:int32 = -1;
  names:LocationStaffNames; // Legacy absence is unknown, not an empty holder.
}
table LocationStaffSnapshot { rows:[LocationStaffRow]; missing_roles:[int32]; }
table LocationStaffSkill { id:int32 = -1; rating:int32; experience:int32; weight:int32; }
table LocationStaffCandidate {
  unit_id:int32 = -1; histfig_id:int32 = -1; name:string; score:int32; skills:[LocationStaffSkill];
  base_name:string; profession_name:string; profession_color:int32 = -1; legendary:bool;
  source_index:int32 = -1; profession_order:int32 = -1; status_order:int32 = -1;
  // Semantic native CP437 comparison keys, not visible text or UI state.
  name_sort_key:[uint8]; profession_sort_key:[uint8];
  // Workshop rows carry ordered semantic assignment indicators.
  assignments:[LocationStaffAssignment];
}
// Native default skill order. Receipt binds epoch, site, location, occupation and all rows.
table LocationStaffCandidates {
  site_id:int32 = -1; location_id:int32 = -1; occupation_id:int32 = -1; role:int32 = -1;
  revision:uint64; cursor:uint32; next_cursor:uint32; total:uint32;
  rows:[LocationStaffCandidate];
}
table LocationAffiliation {
  kind:uint8; id:int32 = -1; name:string; count:int32; workers:int32 = -1;
}
table LocationDetails {
  site_id:int32 = -1; id:int32 = -1; kind:uint8; name:string; revision:uint64;
  access:uint8; visitors:bool; residents:bool; members:bool;
  profession:int32 = -1; tier:int32 = -1; value:int32 = -1;
  desired_copies:int32; recognized:bool;
  supplies:[LocationSupplyQuantity]; zone_ids:[int32];
  appraisal:int32 = -2; // -2 unobserved (legacy), -1 no broker, >=0 effective Appraisal.
  facilities:LocationFacilities; // Absent in legacy records; unknown is not zero.
  written_objects:int32 = -1; // Legacy unknown; count objects, not stack quantities.
  dance_floor_x:int32 = -1; dance_floor_y:int32 = -1; // Both -1 unknown; both zero when absent.
  staff:LocationStaffSnapshot;
  affiliation:LocationAffiliation; // Absent in legacy records; not an empty affiliation.
}
// v71 naming intents use the canonical name revision, not Details revision.
enum LocationRecognitionState : uint8 { NoAction, NeedsTemple, NeedsComplex, NeedsWorshippers, RecognizePriesthood, RecognizeHighPriest }
table LocationReligiousStaff {
  site_id:int32 = -1; location_id:int32 = -1; entity_id:int32 = -1; assignment_id:int32 = -1;
  position_id:int32 = -1; holder_id:int32 = -1; unit_id:int32 = -1;
  revision:uint64; removable:bool;
}

// List revision and selected-candidate revision are independent authorities.
table LocationReligiousCandidates {
  target:LocationReligiousStaff;
  revision:uint64; cursor:uint32; next_cursor:uint32; total:uint32;
  rows:[LocationStaffCandidate];
}
table LocationReligiousAssignment {
  target:LocationReligiousStaff;
  unit_id:int32 = -1; histfig_id:int32 = -1; nemesis_id:int32 = -1;
  revision:uint64; list_revision:uint64; eligible:bool;
}

enum LocationStaffAssignmentKind : uint8 { Occupation, Workshop, Furnace, WorkDetail }
table LocationStaffAssignment {
  kind:LocationStaffAssignmentKind; id:int32 = -1; type:int32 = -1;
  subtype:int32 = -1; custom:int32 = -1; name:string; custom_code:string;
}
table LocationStaffAssignments {
  site_id:int32 = -1; location_id:int32 = -1;
  occupation_id:int32 = -1; entity_id:int32 = -1; assignment_id:int32 = -1;
  unit_id:int32 = -1; histfig_id:int32 = -1; revision:uint64;
  entries:[LocationStaffAssignment];
}

table LocationSpecialization {
  site_id:int32 = -1; location_id:int32 = -1;
  occupation_id:int32 = -1; entity_id:int32 = -1; assignment_id:int32 = -1;
  unit_id:int32 = -1; histfig_id:int32 = -1; revision:uint64;
  eligible:bool; specialized:bool;
}

table LocationRecognition {
  site_id:int32 = -1; location_id:int32 = -1; religion_id:int32 = -1; revision:uint64;
  tier:int32 = -1; rank:int32; worshippers:int32; priest_threshold:int32; high_priest_threshold:int32;
  state:LocationRecognitionState; continuing_agreements:[int32];
}
table LocationNameQuery { component:uint8; query_bytes:[uint8]; cursor:uint32; }
table LocationNameEdit {
  mode:LocationNameMode;
  target:int8 = -1; displayed:int8 = -1;
  word:int32 = -1; part:int16 = -1;
  query_bytes:[uint8];
}
table LocationNameValue {
  first_name_bytes:[uint8]; nickname_bytes:[uint8]; // Exact native CP437, not UTF-8.
  words:[int32]; parts:[int16]; // Exactly seven, including unused components.
  language:int32 = -1; type:int16 = -1; has_name:bool;
}
table LocationNameSnapshot {
  site_id:int32 = -1; id:int32 = -1; kind:uint8;
  namer_id:int32 = -1; namer_race:int16 = -1;
  revision:uint64; value:LocationNameValue;
  native_header:string; english_header:string;
}
table LocationNameChoice {
  word:int32 = -1; part:int16 = -1;
  english:string; translated:string; // Full native forms; clipping belongs to the viewer.
}
table LocationNamePage {
  snapshot:LocationNameSnapshot;
  component:uint8; query_bytes:[uint8]; // Exact owned CP437 filter.
  cursor:uint32; total:uint32; next_cursor:uint32; truncated:bool;
  choices:[LocationNameChoice]; // Native order, including distinct grammatical forms.
}

table AreaState {
  areas:[AreaInfo]; choices:[AreaChoice]; next_cursor:uint32; truncated:bool;
  operation:AreaOperation;
  area_id:int32 = -1;
  list_key:string;
  candidate_kind:uint8;
  sort:uint8;
  sort_descending:bool;
  query:string;
  settings:[AreaSettingRow];
  locations:[AreaLocationRow];
  candidates:[AreaCandidateRow];
  links:[AreaLinkRow];
  list_revision:uint64;
  build_phase:uint8;
  build_done:uint32;
  build_total:uint32;
  omitted:uint32;
  captured_tick:int64 = -1;
  interaction_id:uint64;
  undo_token:uint64;
  room_outcome:AreaRoomOutcome;
  rooms_created:uint32;
  rooms_in_use:uint32;
  rooms_unenclosed:uint32;
  rooms_removed:uint32;
  rooms_dormitories:uint32; // subset of rooms_created for Bedroom Multi
  count_generation:uint64;
  painted_count:int32 = -1; // -1 unknown; never a partial count
  preview_count:int32 = -1;
  location_catalog:LocationCatalog;
  location_details:LocationDetails;
  location_entry_outcome:LocationEntryOutcome;
  location_edit_outcome:LocationEditOutcome;
  location_staff_candidates:LocationStaffCandidates;
  settings_count:int32 = -1; // Complete filtered SettingsPage count; -1 unknown in legacy records.
  query_bytes:[uint8]; // Optional exact owner query echo, including partial UTF-8.
  location_name:LocationNameSnapshot;
  location_name_page:LocationNamePage;
  location_recognition:LocationRecognition;
  location_religious_staff:LocationReligiousStaff;
  location_religious_candidates:LocationReligiousCandidates;
  location_religious_assignment:LocationReligiousAssignment;
  location_specialization:LocationSpecialization;
  location_staff_assignments:LocationStaffAssignments;
}
// Production recipes are opaque semantic keys revalidated against the selected building.
enum FarmOperation : uint8 { Crop, FertilizationToggle, SeasonalFertilization, Rename, Remove, CancelRemoval, ItemForbid, ItemDump, ItemMelt, ItemHidden, WorkerSelect, WorkerRemove, WorkerSpecialize }
table ProductionRequest {
  building_id:int32 = -1;
  job_id:int32 = -1;
  recipe:string;
  query:string;
  cursor:uint32;
  repeat:int8 = -1;
  suspend:int8 = -1;
  cancel:bool;
  season:int8 = -1;
  crop_id:int32 = -1;
  expected_revision:uint64;
  farm_operation:FarmOperation;
  seasonal_fertilization:int8 = -1;
  farm_name:string;
  contents:bool;
  item_id:int32 = -1;
  item_value:int8 = -1;
  locate_item:bool;
  independent_item:bool;
  building_header:bool;
  workshop_workers:bool;
  worker_id:int32 = -1;
  worker_list_revision:uint64;
  worker_value:int8 = -1;
  workshop_orders:bool;
  general_order_delta:int8;
  general_order_value:int16 = -1;
  contents_item_id:int32 = -1; // Child target; item_id and expected_revision identify its containing item.
}
table ProductionRequirement { description:string; quantity:int32; item_type:int16 = -1; }
// Absent on legacy observations and providers without native availability evidence.
table ProductionAvailability { available:bool; objection:string; }
table ProductionRecipe { key:string; name:string; requirements:[ProductionRequirement]; availability:ProductionAvailability; }
table ProductionJob {
  id:int32; name:string; job_type:int16; repeat:bool; suspended:bool;
  worker_id:int32 = -1; worker_name:string; completion_timer:int32 = -1;
  attached_items:uint16; editable:bool; status:string;
  requirements:[ProductionRequirement];
}
table ProductionBuilding {
  id:int32; name:string; kind:string; origin:TilePos;
  build_stage:int16; max_stage:int16; queue_size:uint16;
}
table FarmCrop { id:int32; name:string; seasons:uint8; seeds:uint32; }
// Native choices for one locally selected tab. Availability is not a seed count.
// A missing snapshot means unavailable; legacy FarmCrop fields cannot synthesize it.
table NativeFarmCrop { id:int32; name:string; seeds_available:bool; current_season_warning:bool; raw_id:string; }
enum FarmEditOutcome : uint8 { None, Completed, Rejected, Stale, Unknown }
table FarmSnapshot {
  building_id:int32 = -1;
  revision:uint64;
  selected_season:int8 = -1;
  current_season:int8 = -1;
  seasonal_crops:[int32];
  choices:[NativeFarmCrop];
  current_fertilization:int32;
  max_fertilization:int32;
  pending_fertilization:int32;
  seasonal_fertilization:bool;
  custom_name:string;
  header_name:string;
  removing:bool;
  removal_suspended:bool;
  removal_has_worker:bool;
}
// A page is tied to the revision of the complete native contents vector.
table BuildingContentsItem {
  id:int32 = -1; role:int32 = -1; name:string;
  forbid:bool; dump:bool; melt:bool; hidden:bool;
  can_dump:bool; can_melt:bool; in_job:bool; in_building:bool;
  item_type:int32 = -1; material_token:string; subtype_raw:string;
  appearance:ItemInspectionAppearance;
}
table BuildingContentsPage {
  building_id:int32 = -1; revision:uint64;
  cursor:uint32; next_cursor:uint32; total:uint32;
  completed:bool; removing:bool; rows:[BuildingContentsItem];
}
table BuildingItemReceipt { item_id:int32 = -1; operation:FarmOperation; value:int8 = -1; }
// Native item inspection owns its text; revision is observed after lazy formatting.
table ItemBuildingHolder { id:int32 = -1; type:int32 = -1; name:string; }
table ItemPosition { id:int32 = -1; position:TilePos (required); }
table BuildingItemSnapshot {
  building_id:int32 = -1; revision:uint64;
  completed:bool; removing:bool;
  item:BuildingContentsItem;
  weight:string; description:string;
  holder:ItemBuildingHolder;
}
// Item-owned authority: no containing-building identity, role or build state.
// kind: 1 container item, 2 unit. Unit item_type must remain -1.
table ItemContainerContentFacts { item_type:int16 = -1; material_token:string; color_token:string; effective_armor_level:int8; metal:bool; coal:bool; contains_powder:bool; rolls_sheets:bool; protects_folded_sheets:bool; contains_writing:bool; liquid:bool; subterranean_plant:bool; }
// BIN: all direct item/unit references in order, gated by container.
// BAG: at most the last CONTAINS_ITEM reference (including an unresolved entry),
// regardless of container; colors are solid actual-material/powder-profile colors.
// BARREL: selected last item reference, gated by container; material/color
// facts are from actual material. material_inorganic=-1 is unknown/other family.
table ItemContainerContentsFacts { container:bool; entries:[ItemContainerContentFacts]; material_inorganic:int8 = -1; solid_color:string; }
table ItemInspectionAppearance { material_token:string; subtype_raw:string; color_token:string; stack:int32; flags:uint8; instrument_family:int8 = -1; instrument_placed:int8 = -1; contents:ItemContainerContentsFacts; floodgate_open:int8 = -1; door_open:int8 = -1; door_forbidden:int8 = -1; door_wear:int8 = -1; bucket_liquid:int8 = -1; bucket_liquid_color:string; cage_material_family:int8 = -1; cage_occupant_entity:int8 = -1; cage_occupant_id:int32 = -1; cage_solid_color:string; restraint_rope:int8 = -1; restraint_solid_color:string; portrait:SelectionAppearance; cage_occupant:SelectionAppearance; slab_engraving:int8 = -2; corpse_selector:SelectionAppearance; }
table ItemCarrier { kind:int8; id:int32 = -1; item_type:int32 = -1; name:string; appearance:ItemInspectionAppearance; }
table ItemOwner { id:int32 = -1; name:string; }
table ItemAmmunitionAssignment { kind:int8; squad_id:int32 = -1; caption:string (required); }
table ItemSheetContent { kind:int8; id:int32 = -1; caption:string (required); item_type:int32 = -1; flags:uint32; can_dump:bool; can_melt:bool; appearance:ItemInspectionAppearance; }
table ItemUseRow { caption:string (required); reaction:int32 = -1; }

table IndependentItemSnapshot {
  id:int32 = -1; revision:uint64; item_type:int32 = -1;
  name:string; material_token:string; subtype_raw:string;
  forbid:bool; dump:bool; melt:bool; hidden:bool;
  can_dump:bool; can_melt:bool; in_job:bool; in_building:bool;
  weight:string; description:string;
  holder:ItemBuildingHolder; stockpile:ItemBuildingHolder;
  stockpile_categories:int32 = -1; // DF stockpile_group_set; -1 requires absent stockpile.
  carrier:ItemCarrier; // Mutually exclusive with building holder.
  appearance:ItemInspectionAppearance; // Required for BOX/INSTRUMENT; other families may provide verified facts.
  owner:ItemOwner; // Absent means no resolved UNIT_ITEMOWNER; independent of carrier.
  ammunition_assignment:ItemAmmunitionAssignment; // Optional observed status; absent is unknown, not unassigned.
  contents:[ItemSheetContent]; // Absent is unknown; present empty is known empty. Ordered mixed item/unit rows.
  uses:[ItemUseRow]; // Absent is unknown; present empty is known empty. Native ordered captions and reaction identities.
}
table IndependentItemState {
  snapshot:IndependentItemSnapshot; edit:BuildingItemReceipt;
  outcome:FarmEditOutcome;
}
table BuildingHeaderSnapshot {
  id:int32 = -1; type:int32 = -1; revision:uint64;
  stage:int32 = -1; max_stage:int32 = -1;
  custom_name:string; native_name:string; header_name:string;
  removing:bool; suspended:bool; has_worker:bool;
}
table BuildingHeaderState {
  snapshot:BuildingHeaderSnapshot;
  outcome:FarmEditOutcome;
  operation:FarmOperation;
}
table WorkshopAssignedWorker {
  id:int32 = -1; caption:string; specialization_visible:bool;
  can_specialize:bool; specialized:bool;
}
table WorkshopWorkersState {
  building_id:int32 = -1; profile_revision:uint64; permitted_workers:[int32];
  revision:uint64; cursor:uint32; next_cursor:uint32; total:uint32;
  rows:[LocationStaffCandidate]; outcome:FarmEditOutcome; unit_id:int32 = -1;
  assigned:WorkshopAssignedWorker; operation:FarmOperation;
}
table WorkshopOrdersState {
  building_id:int32 = -1; revision:uint64; manager_available:bool;
  general_order_limit:int32; order_ids:[int32];
  outcome:FarmEditOutcome; delta:int8; value:int16 = -1;
}
table ProductionState {
  buildings:[ProductionBuilding]; next_cursor:uint32;
  recipes:[ProductionRecipe]; jobs:[ProductionJob]; crops:[FarmCrop];
  seasonal_crops:[int32]; current_season:int8 = -1;
  selected_building:int32 = -1; created_job:int32 = -1;
  detail:string;
  farm:FarmSnapshot;
  farm_edit_outcome:FarmEditOutcome;
  contents:BuildingContentsPage;
  contents_edit:BuildingItemReceipt;
  item:BuildingItemSnapshot;
  item_position:ItemPosition;
  independent_item:IndependentItemState;
  building_header:BuildingHeaderState;
  workshop_workers:WorkshopWorkersState;
  workshop_orders:WorkshopOrdersState;
}
// Details is a distinct intent; choice IDs refer to the observed native catalog.
// Artwork subject IDs are simulation IDs, not Details choice ordinals.
// Update with page=-1 enters Image; page=0 delegates to the artist.
// Draft values are viewer-owned semantic data. Native pointers and editor
// scratch never cross the wire. Only Commit installs an image in the world.
enum WorkOrderArtDraftAction:uint8 { Inspect, AddElement, AddRelationship, Delete, GenerateName, Commit, EditName }
table WorkOrderArtDraftElement { kind:int16; id:int32 = -1; secondary:int32 = -1; quantity:int32 = 1; }
table WorkOrderArtDraftRelationship { verb:int32 = -1; transitive:bool; actor:int32 = -1; target:int32 = -1; }
table WorkOrderArtDraftValue {
  elements:[WorkOrderArtDraftElement] (required);
  relationships:[WorkOrderArtDraftRelationship] (required);
  name:LocationNameValue;
}
table WorkOrderArtDraftRequest {
  value:WorkOrderArtDraftValue (required);
  action:WorkOrderArtDraftAction;
  element:WorkOrderArtDraftElement;
  relationship:WorkOrderArtDraftRelationship;
  delete_index:int32 = -1;
  columns:uint16;
  name_query:LocationNameQuery;
  name_edit:LocationNameEdit;
}
table WorkOrderArtName {
  native_header:string; english_header:string;
  component:uint8; query_bytes:[uint8]; cursor:uint32; total:uint32; next_cursor:uint32;
  choices:[LocationNameChoice];
}
table WorkOrderArtRequest {
  page:int16 = -1; subject:int32 = -1;
  expected_list_revision:uint64; query:string; cursor:uint32;
  hovered:int32 = -1; preview_columns:uint16;
  draft:WorkOrderArtDraftRequest;
}
table WorkOrderArtRow { id:int32; caption:string; badge:string; secondary:int32 = -1; }
table WorkOrderArtState {
  page:int16 = -1; caption:string; rows:[WorkOrderArtRow];
  list_revision:uint64; total:uint32; next_cursor:uint32;
  hovered:int32 = -1; preview:[string];
  draft:WorkOrderArtDraftValue;
  draft_description:[string];
  name:WorkOrderArtName;
}
table WorkOrderDetailsRequest {
  option:int16 = -1;
  choice:int32 = -1;
  expected_choices_revision:uint64;
  query:string;
  cursor:uint32;
  art:WorkOrderArtRequest;
  dye_target:int32 = -1;
  dye_filter_applied:bool;
}
table WorkOrderDetailsOption { kind:uint8; index:int32 = -1; caption:string; }
struct WorkOrderDyeColor { red:float; green:float; blue:float; }
table WorkOrderDetailsChoice { id:int32; caption:string; count_caption:string; estimated:bool; dye_color:int32 = -1; opens_menu:bool; swatch:WorkOrderDyeColor; }
table WorkOrderDetailsState {
  id:int32 = -1; revision:uint64; caption:string;
  options:[WorkOrderDetailsOption];
  selected_option:int16 = -1;
  choices:[WorkOrderDetailsChoice]; // absent until a choice catalog is observed
  choices_revision:uint64;
  total:uint32; next_cursor:uint32;
  art:WorkOrderArtState;
  current_value:string; // Native selected-setting text, absent when unobserved.
  setting_heading:string;
  dye_target:int32 = -1;
}
table WorkOrderRequest {
  id:int32 = -1;
  expected_revision:uint64;
  recipe:string;
  query:string;
  cursor:uint32;
  remaining:int32 = -1;
  frequency:int8 = -1;
  workshop_id:int32 = -2;
  max_workshops:int32 = -1;
  condition_kind:uint8;
  condition_index:int16 = -1;
  remove_condition:bool;
  compare:int8 = -1;
  threshold:int32 = -1;
  item_type:int16 = -1;
  target_order:int32 = -1;
  dependency:int8 = -1;
  candidate_kind:uint8;
  move:int8;
  expected_neighbor:int32 = -1;
  expected_list_revision:uint64;
  item_subtype:int16 = -1;
  mat_type:int16 = -1;
  mat_index:int32 = -1;
  traits:[string];
  input_index:int16 = -1;
  group_type:int16 = -1;
  group_subtype:int16 = -1;
  group_custom:int32 = -1;
  encrust_flags:int32 = -1;
  // Add this freshly rebuilt native suggestion; exclusive of manual filters.
  suggestion_index:int16 = -1;
  // Native filter catalog identity; candidate_kind 3=type, 4=material, 5=trait.
  filter_choice:int32 = -1;
  details:WorkOrderDetailsRequest;
}
table WorkOrderCondition {
  kind:uint8; index:uint16; description:string; editable:bool;
  compare:int8 = -1; threshold:int32 = -1; item_type:int16 = -1;
  target_order:int32 = -1; dependency:int8 = -1; satisfied:bool;
  item_subtype:int16 = -1; mat_type:int16 = -1; mat_index:int32 = -1;
  traits:[string];
  satisfaction:uint8; // 0 unknown, 1 pending, 2 known
  estimated:bool;
  estimate_count:int32 = -1;
  item_caption:string; // optional native item-filter wording
}
enum WorkOrderPhase : uint8 { Unknown, Active, Waiting, Checking, Ready }
// Native observation, absent in legacy recordings. A stale clock or locally
// rendered controls cannot supply these facts.
table WorkOrderNativeState {
  phase:WorkOrderPhase;
  validation_required:bool;
  details_available:bool;
  workshop_name:string; // absent means not observed; <=512 B
}
table WorkOrderListNativeState {
  manager_available:bool;
  validation_required:bool;
}
table WorkOrderInfo {
  id:int32; revision:uint64; name:string;
  total:int16; remaining:int16; frequency:int8;
  validated:bool; active:bool;
  finished_year:int32 = -1; finished_tick:int32 = -1;
  workshop_id:int32 = -1; max_workshops:int32;
  generated_jobs:[int32]; conditions:[WorkOrderCondition];
  editable:bool; reason:string;
  position:int32 = -1;
  detail_kind:uint8; // 0 unknown, 1 none, 2 material, 3 plant, 4 size, 5 gem, 6 cloth+size
  size_raw:int32 = -1;
  encrust_flags:int32;
  mat_type:int16 = -1; mat_index:int32 = -1;
  material_category:uint32;
  inputs:[WorkOrderInput]; // <=64 per order, <=128 across the page; descriptions <=1024 B
  native_state:WorkOrderNativeState;
  suggested_conditions:[WorkOrderCondition]; // absent means not observed; <=128
}
table ManagerRole {
  unit_id:int32; name:string; position:string; offices:[int32]; job:string;
}
table WorkOrderState {
  orders:[WorkOrderInfo]; recipes:[ProductionRecipe]; choices:[AreaChoice];
  managers:[ManagerRole]; next_cursor:uint32; detail:string;
  materials:[WorkOrderMaterial]; traits:[WorkOrderTrait]; types:[WorkOrderItemType];
  groups:[WorkOrderGroup]; tasks:[WorkOrderTask];
  total:uint32; list_revision:uint64;
  build_phase:uint8; // 0 done, 1 read, 2 sort, 3 filter
  build_done:uint32; build_total:uint32;
  native_state:WorkOrderListNativeState; // absent in legacy observations
  details:WorkOrderDetailsState;
}
enum WorkDetailWorkerSort : uint8 { Category, Name, Profession, Skills }
// Positional work-detail identity is guarded by the existing detail-inspection receipt.
// A toggle is a one-shot native definition edit, never a forced worker recalc.
// Owned Kitchen queries and full ordered exclusion receipts. Legacy Kitchen UI actions stay retired.
enum StoneUseOutcome : uint8 { None, Applied, Rejected, Stale, Unknown }
table StoneUseRequest { category:int32 = -1; index:int32 = -1; expected:[uint8]; }
table StoneUseRow { category:int32; index:int32; restricted:bool; name:string (required); uses:string (required); magma_safe:bool; material_token:string (required); }
table StoneUseState { outcome:StoneUseOutcome; rows:[StoneUseRow] (required); restrictions:[uint8] (required); }

enum KitchenMenuOutcome : uint8 { None, Applied, Rejected, Stale, Unknown }
enum KitchenSortColumn : uint8 { Type, Name, Number, Cook, Brew }
table KitchenFoodKey { item_type:int16 = -1; item_subtype:int16 = -1; mat_type:int16 = -1; mat_index:int32 = -1; }
table KitchenFoodReceipt { key:KitchenFoodKey (required); count:int32; capabilities:uint8; }
table KitchenExclusion { key:KitchenFoodKey (required); flags:uint8; }
table KitchenSort { column:KitchenSortColumn; reverse:bool; }
// Ordered priorities may repeat. Repeated columns share direction; maximum65536
// entries is a request allocation bound, not a native five-column UI limit.
table KitchenMenuQuery { type_filter:int8 = -1; capability_filter:uint8; query:string (required); sorts:[KitchenSort] (required); }
table KitchenMenuRequest { query:KitchenMenuQuery; target:KitchenFoodReceipt; permission:uint8; expected:[KitchenExclusion]; }
table KitchenMenuRow { receipt:KitchenFoodReceipt (required); name:string (required); count_caption:string (required); estimated:bool; excluded:uint8; material_token:string (required); }
table KitchenMenuState { outcome:KitchenMenuOutcome; rows:[KitchenMenuRow] (required); exclusions:[KitchenExclusion] (required); }

enum ChoresOutcome : uint8 { None, Applied, Rejected, Stale, Unknown }
enum ChoresOperation : uint8 { None, Enabled, Labor, Exempt }
table ChoreLabor { id:int32 = -1; enabled:bool; }
table ChoresSnapshot { enabled:bool; children:[int32] (required); exempted:[int32] (required); labors:[ChoreLabor] (required); }
table ChoresCaption { id:int32 = -1; caption:string (required); }
table ChoresRequest { operation:ChoresOperation; id:int32 = -1; value:bool; expected:ChoresSnapshot; }
table ChoresState { outcome:ChoresOutcome; snapshot:ChoresSnapshot; children:[ChoresCaption] (required); labors:[ChoresCaption] (required); }

enum HunterAmmunitionOutcome : uint8 { None, Applied, Rejected, Stale, Unknown }
enum HunterAmmunitionOperation : uint8 { None, Amount, Material, Add, Delete, Remove }
table HunterAmmunitionSpec {
  item_type:int16 = -1; item_subtype:int16 = -1;
  material_class:int16 = -1; mattype:int16 = -1; matindex:int32 = -1;
  amount:int32; flags:uint32; assigned:[int32] (required);
}
table HunterAmmunitionRequest {
  operation:HunterAmmunitionOperation; index:int32 = -1; item_id:int32 = -1; amount:int32 = -1;
  item_type:int16 = -1; item_subtype:int16 = -1;
  material_class:int16 = -1; mattype:int16 = -1; matindex:int32 = -1;
  expected:[HunterAmmunitionSpec];
}
table HunterAmmunitionStack { id:int32 = -1; caption:string (required); quantity:int32; appearance:ItemInspectionAppearance (required); }
table HunterAmmunitionRule { caption:string (required); quantity:int64; items:[HunterAmmunitionStack] (required); }
table HunterAmmunitionType { item_type:int16 = -1; item_subtype:int16 = -1; foreign:bool; caption:string (required); }
table HunterAmmunitionMaterial { material_class:int16 = -1; mattype:int16 = -1; matindex:int32 = -1; caption:string (required); }
table HunterAmmunitionState {
  outcome:HunterAmmunitionOutcome; item_type:int16 = -1; item_subtype:int16 = -1;
  specs:[HunterAmmunitionSpec] (required); rules:[HunterAmmunitionRule] (required);
  types:[HunterAmmunitionType] (required); materials:[HunterAmmunitionMaterial] (required);
}

enum StandingOrdersOutcome : uint8 { None, Applied, Rejected, Stale, Unknown }
// Category0 is Workshops. Other Standing orders workflows are not yet exposed.
table StandingOrdersRequest { category:uint8; setting_id:int32 = -1; expected_value:int8 = -1; value:int8 = -1; }
table StandingOrderSetting { id:int32 = -1; value:uint8; visible:bool; editable:bool; }
table StandingOrdersState { category:uint8; outcome:StandingOrdersOutcome; settings:[StandingOrderSetting] (required); }

table WorkDetailSettingsRequest { detail_index:int32 = -1; expected_revision:uint64; setting_id:int32 = -1; }
table WorkDetailSetting { id:int32 = -1; caption:string (required); }
table WorkDetailSettingsState {
  detail_index:int32 = -1; revision:uint64; editable:bool; no_modify:bool;
  labors:[int16] (required); catalog:[WorkDetailSetting] (required);
}
// Ordered native keys, including duplicates; a column shares one direction.
table WorkDetailSort { column:WorkDetailWorkerSort; descending:bool; }
table WorkDetailWorkersRequest {
  detail_index:int32 = -1; expected_revision:uint64;
  sorts:[WorkDetailSort] (required); query_bytes:[uint8];
}
enum ResidentsSort : uint8 { Category, Name, Profession, Stress, Activity }
// Query bytes mirror the native textbox, including partial UTF-8 after Backspace.
table ResidentsRequest { sort:ResidentsSort; descending:bool; query_bytes:[uint8]; }
// Complete native order at one safe point; no paginated mixture of roster states.
table ResidentsState { unit_ids:[int32]; }
// Bounded content reads for an explicit window of the ordered query result.
table ResidentsRowsRequest { unit_ids:[int32] (required); columns:uint16; show_gender:bool; detail_index:int32 = -1; expected_revision:uint64; }
enum ResidentsSpecializationOutcome : uint8 { Applied, Rejected, Stale, Unavailable, Unknown }
table ResidentSpecialization { only_assigned:bool; revision:uint64; }
table ResidentsSpecializationRequest { unit_id:int32 = -1; expected_revision:uint64; only_assigned:bool; }
table ResidentsSpecializationState { unit_id:int32 = -1; outcome:ResidentsSpecializationOutcome; only_assigned:bool; }
// A row's observed event identity. Requests refuse a different current event.
table ResidentJobTarget { job_id:int32 = -1; building_id:int32 = -1; }
table ResidentActivityTarget { activity_id:int32 = -1; event_id:int32 = -1; }
// Shared job-backed settings; IDs refer to simulation jobs, never manager orders.
enum JobSettingsEditOutcome : uint8 { Rejected, Stale, Applied, Unknown }
table JobSettingsEditRequest {
  job_id:int32 = -1; building_id:int32 = -1; unit_id:int32 = -1;
  option:int16 = -1; expected_revision:uint64; expected_choices_revision:uint64; choice:int32 = -1;
  art_page:int16 = -2; query:string; art:WorkOrderArtRequest;
}
table JobSettingsEditState { job_id:int32 = -1; building_id:int32 = -1; unit_id:int32 = -1; outcome:JobSettingsEditOutcome; }
table JobSettingsRequest { job_id:int32 = -1; building_id:int32 = -1; unit_id:int32 = -1; option:int16 = -1; query:string; cursor:uint32; art_page:int16 = -2; expected_list_revision:uint64; hovered:int32 = -1; preview_columns:uint16; expected_revision:uint64; art:WorkOrderArtRequest; }
table JobSettingsChoice { id:int32 = -1; caption:string; count_caption:string; estimated:bool; }
table JobSettingsState {
  job_id:int32 = -1; building_id:int32 = -1; unit_id:int32 = -1;
  revision:uint64; caption:string; options:[WorkOrderDetailsOption];
  selected_option:int16 = -1; choices:[JobSettingsChoice]; choices_revision:uint64;
  total:uint32; cursor:uint32; next_cursor:uint32;
  current_value:string; setting_heading:string;
  art:WorkOrderArtState;
}
table ResidentsActivityRequest { unit_id:int32 = -1; activity_id:int32 = -1; event_id:int32 = -1; columns:uint16; }
table ActivityDescriptionWord { text:string (required); red:uint8; green:uint8; blue:uint8; link:int32 = -1; flags:uint8; x:int32 = -1; y:int32 = -1; }
table ActivityDescriptionLink { type:int32 = -1; id:int32 = -1; subid:int32 = -1; }
table ResidentsActivityState {
  unit_id:int32 = -1; activity_id:int32 = -1; event_id:int32 = -1;
  columns:uint16; max_y:int32;
  words:[ActivityDescriptionWord] (required); links:[ActivityDescriptionLink] (required);
}
table WorkDetailSkill { skill:int16 = -1; rating:int32; caption:string (required); }
table ResidentRow {
  id:int32 = -1;
  combined:string (required); name:string (required); profession:string (required);
  first_line:string (required); second_line:string (required);
  name_color:AreaNameColor (required);
  activity:string (required); activity_foreground:uint8; activity_background:uint8; activity_bright:bool;
  // Optional additive observation: older row producers did not supply artwork.
  sheet_icon:SelectionAppearance;
  happiness:int8 = -1; // -1 unobserved;0 happiest through6 most distressed.
  specialization:ResidentSpecialization;
  assignments:[LocationStaffAssignment];
  // Residents Recenter captures raw unit.pos when constructing the row.
  position:TilePos;
  activity_target:ResidentActivityTarget;
  // Optional additive identity for the native job-backed Details button.
  job_target:ResidentJobTarget;
  // Present only for WorkDetailRowsRead; activity/happiness are unobserved there.
  work_detail_skills:[WorkDetailSkill];
  detail_member:int8 = -1;
}
table ResidentsRowsState { rows:[ResidentRow] (required); }

table CitizenRequest {
  unit_id:int32 = -1;
  detail_index:int32 = -1;
  expected_revision:uint64;
  cursor:uint32;
  query:string;
  member:int8 = -1;
  mode:int8 = -1;
  name:string;
  labors:[int16];
  edit:uint8; // 0 unknown, 1 rename, 2 labors, 3 reset to default
  only_assigned:int8 = -1;
  expected_list_revision:uint64;
}
table CitizenRole { name:string; required_office:int32; }
table CitizenWorkDetail { index:int32; icon:int32; name:string; }
table CitizenInfo {
  id:int32; name:string; profession:string; job:string;
  age:int32 = -1; stress:int32; has_stress:bool;
  origin:TilePos; can_focus:bool; eligible:bool; reason:string;
  labors:[int16]; roles:[CitizenRole]; offices:[int32]; labor_names:[string];
  profession_color:int32 = -1; profession_id:int32 = -1; job_type:int32 = -1;
  sheet_icon:SelectionAppearance;
  only_assigned_jobs:bool; assigned_details:[CitizenWorkDetail];
  social_activity:bool;
  revision:uint64;
  detail_member:int8 = -1;
  detail_skill:int16 = -1;
  detail_skill_rating:int16 = -1;
  detail_skill_name:string;
  portrait_state:uint8; // 0 unknown, 1 ok, 2 unresolved, 3 deferred
  row_error:string;
}
table WorkDetailInfo {
  index:int32; revision:uint64; name:string; mode:uint8;
  no_modify:bool; cannot_be_everybody:bool; editable:bool; mode_editable:bool;
  reason:string; labors:[int16]; assigned_units:[int32]; labor_names:[string];
  icon:int32 = -2; // Read-only; -2 unknown, -1 NONE.
  row_error:string;
}
table CitizenState {
  citizens:[CitizenInfo]; details:[WorkDetailInfo]; next_cursor:uint32;
  selected_unit:int32 = -1; selected_detail:int32 = -1;
  external_controller:bool; detail:string;
  recalc_done:uint32;
  recalc_total:uint32;
  recalc_error:string;
  detail_list_revision:uint64;
  // Only rejected citizen mutations may carry uncertainty; no authoritative rows.
  outcome_unknown:bool;
}
enum SelectionOperation : uint8 { OpenTile, Inspect, SelectAlternative, InspectItem, ViewContainer, Back }
enum SelectionKind : uint8 { None, Unit, Item, Building, Engraving, PlannedEngraving, UnitList, ItemList, Vermin }
enum SelectionSection : uint8 { AgeSex, Traits, Health, Citizenship, Military, CurrentThought, RecentThoughts, Relationships, Hauling, LaborSkills, UnmetNeeds }
table SelectionRequest { operation:SelectionOperation; tile:TilePos; receipt:uint64; index:int32 = -1; }
table SelectionIdentity { kind:SelectionKind; id:int32 = -1; name:string (required); }
table SelectionText { section:SelectionSection; text:string (required); }
table SelectionItem { id:int32; name:string (required); }
// Original-asset references under the existing appearance exception.
table SelectionAppearance { tile_pages:[string] (required); palettes:[string] (required); layers:[AppearanceLayer] (required); }
table SelectionState {
 open:bool; receipt:uint64; kind:SelectionKind; id:int32 = -1; tile:TilePos;
 title:string (required); subtitle:string (required); job:string (required); description:string (required);
 alternatives:[SelectionIdentity] (required); items:[SelectionItem] (required); overview:[SelectionText] (required);
 container:SelectionIdentity; weight:int32 = -1; value:int32 = -1; passable:bool; is_door:bool;
 portrait:SelectionAppearance; complete:bool = true;
}
enum AlertOperation : uint8 { OpenCategory, Inspect, OpenUnit, Recenter, Back, Dismiss, OpenHistory, SelectTab, Scroll }
enum AlertView : uint8 { Closed, Category, Unit, History }
table AlertRequest {
 operation:AlertOperation;
 category:int16 = -1;
 receipt:uint64;
 entry:int32 = -1;
 tab:int16 = -1;
 delta:int16;
}
table AlertEntry {
 text:string (required);
 report_id:int32 = -1;
 unit_id:int32 = -1;
 unit_category:int8 = -1;
 can_recenter:bool;
}
table AlertState {
 view:AlertView;
 receipt:uint64;
 category:int16 = -1;
 unit_id:int32 = -1;
 unit_category:int8 = -1;
 entries:[AlertEntry] (required);
 tabs:[string] (required);
 selected_tab:int16 = -1;
 scroll:int32;
 total:uint32;
 complete:bool = true;
 focus:TilePos;
}
enum ReportView : uint8 { Flat, Tab, UnitList, UnitLog, Entries, Text, Group }
enum ReportTab : uint8 { Unknown, All, General, World, Environment, Arrivals, Attacks, Trade, Nobles, Animal, LifeChanges, StrangeMoods, ProfessionChanges, Military, MentalState, Masterpieces, JobFailures, Death, Ghosts, Wildlife, Labor, Crime, Curses, Combat, Sparring, Hunting }
enum ReportZoom : uint8 { Unknown, None, Generic, Item, Unit }
// Tab: revision zero captures all ordinary tabs; nonzero reads that retained snapshot.
// UnitList and UnitLog revisions are independent. Epoch/bridge reset invalidates owners.
// UnitLog refresh explicitly appends new identities while retaining existing rows.
// PrepareAlertDismissal/DismissAlert use flat defaults and no read selectors.
// expected_list_revision consumes a client/epoch-bound full red-vector receipt;
// ReportState.list_revision echoes it and total is the captured/cleared count.
table ReportRequest {
  id:int32 = -1; before_id:int32 = -1; query:string; announcements_only:bool = true;
  view:ReportView; tab:ReportTab; after_id:int32 = -1; from_end:bool;
  unit_id:int32 = -1; unit_category:int8 = -1; cursor:uint32; expected_list_revision:uint64;
  ids:[int32]; units:[UnitReportReference]; refresh:bool;
  notification_category:int16 = -1; alert_button:bool;
}
table ReportInfo {
  id:int32; category:string; text:string; year:int32; year_tick:int32;
  repeat_count:int32; continuation:bool; text_complete:bool = true;
  x:int32 = -1; y:int32 = -1; z:int32 = -1;
  x2:int32 = -1; y2:int32 = -1; z2:int32 = -1;
  position_visible:bool; position2_visible:bool;
  tab:ReportTab; color:int16 = -1; bright:bool; zoom_type:ReportZoom; zoom_type2:ReportZoom;
  position_hidden:bool; position2_hidden:bool; speaker_id:int32 = -1;
}
table ReportUnitInfo { unit_id:int32 = -1; category:int8 = -1; profession:string; name:string; dead:bool; log_count:uint32; error:string; }
table ReportState {
  reports:[ReportInfo]; next_before_id:int32 = -1; announcements_only:bool = true; detail:string;
  view:ReportView; tab:ReportTab; after_id:int32 = -1; from_end:bool;
  tab_counts:[uint32]; total:uint32; next_after_id:int32 = -1; trimmed_through:int32 = -1; gap:bool;
  unit_id:int32 = -1; unit_category:int8 = -1; cursor:uint32; next_cursor:uint32; list_revision:uint64; units:[ReportUnitInfo]; missing_ids:[int32];
  notification_category:int16 = -1; alert_button:bool;
}
// Pending comes from plotinfo.petitions, never the cached native menu vector.
enum AgreementStatus : uint8 { Pending, Accepted, Unapproved, Concluded }
table AgreementRequest { id:int32 = -1; before_id:int32 = -1; query:string; pending_only:bool; tracker:bool; }
table AgreementDetail {
  id:int32; kind:int16 = -1; site_id:int32 = -1; year:int32; year_tick:int32;
  applicant_party:int32 = -1; government_party:int32 = -1;
  location_type:int16 = -1; tier:int32 = -1; profession:int16 = -1;
  deity_type:int16 = -1; deity_id:int32 = -1; description:string;
}
table AgreementParty { id:int32; entity_ids:[int32]; histfig_ids:[int32]; name:string; }
table AgreementInfo {
  id:int32; status:AgreementStatus; not_approved:bool; concluded:bool; continuing:bool;
  details:[AgreementDetail]; parties:[AgreementParty]; summary:string; complete:bool = true; reason:string;
}
table ContinuingAgreementRow {
  agreement_id:int32 = -1; subject_id:int32 = -1; entity_id:int32 = -1; entity_type:int32 = -1;
  tier:int32 = -1; profession:int32 = -1; year:int32; year_tick:int32;
  heading:string; applicant:string; date:string;
}
table ContinuingAgreementDetails { required_value:int32 = -1; matching_locations:int32; location_id:int32 = -1; location_value:int32; location_tier:int32 = -1; site_available:bool; tier_met:bool; location_name:string; }
table AgreementState { agreements:[AgreementInfo]; next_before_id:int32 = -1; pending_only:bool; detail:string; tracker:bool; tracker_rows:[ContinuingAgreementRow]; tracker_details:ContinuingAgreementDetails; }
table TradeRequest { depot_id:int32 = -1; item_id:int32 = -1; expected_revision:uint64; requested:int8 = -1; anyone:int8 = -1; cursor:uint32; query:string; receipt:uint64; side:uint8; selected:int8 = -1; }
table TradeDepot { id:int32; origin:TilePos; revision:uint64; requested:bool; anyone:bool; accessible:bool; ready:bool; broker:string; hauling:uint32; goods:uint32; }
table TradeCaravan { id:int32; name:string; state:string; days_remaining:int32; }
table TradeGood { id:int32; description:string; quantity:uint32 = 1; selected:bool; selectable:bool; reason:string; }
table TradeExchange { open:bool; receipt:uint64; side:uint8; can_submit:bool; merchant_count:uint32; fort_count:uint32; merchant_selected:uint32; fort_selected:uint32; entity_id:int32 = -1; merchant_id:int32 = -1; broker_id:int32 = -1; reply:string; reason:string; outcome:uint8; }
table TradeState { depots:[TradeDepot]; caravans:[TradeCaravan]; goods:[TradeGood]; next_cursor:uint32; selected_depot:int32 = -1; detail:string; exchange:TradeExchange; }

// Places pages retain native order for one locally selected tab. Subsequent
// pages require the same membership revision; captions may refresh independently.
// Native Nobles order, with locally owned paging. Continuations require the
// same membership revision. NEW offices have assignment_id -1; office identity
// is the entity/position/assignment triple, never a native menu index.
enum NoblesOutcome : uint8 { None, Rejected, Stale, Applied, Unknown }
// Existing assignments use slot0. For NEW offices, the initial placeholder is
// slot0 and a placeholder created by choice N has slot N (one-based). These
// replay-local identities are scoped to the initial list revision, never native
// menu indices; removing a slot does not renumber surviving slots.
struct NoblesOffice { entity_id:int32; position_id:int32; assignment_id:int32; draft_slot:uint32; }
table NoblesChoice {
  target:NoblesOffice (required); expected_unit_id:int32 = -1; unit_id:int32 = -1;
}
table NoblesRequest {
  offset:uint32; limit:uint16 = 32; expected_list_revision:uint64;
  choices:[NoblesChoice]; target:NoblesOffice; expected_candidate_revision:uint64;
}
table NoblesCandidateSkill { id:int16 = -1; rating:int32; caption:string (required); }
table NoblesCandidate {
  unit_id:int32 = -1; value:int32; caption:string (required); no_skills:string (required);
  skills:[NoblesCandidateSkill] (required); appearance:SelectionAppearance;
}
// Native help content; layout and hover selection remain presentation-owned.
table NoblesAssessmentHelp { actual:string (required); required:string (required); color:uint8 = 15; }
table NoblesObligationHelp { text:string (required); color:uint8 = 15; }
table NoblesAccountingHelp {
  setting:uint8; level:uint8;
  title:string (required); examples:string (required); attained:string (required); progress:string (required);
}
table NoblesHelp {
  description:string (required);
  rooms:[NoblesAssessmentHelp] (required); furniture:[NoblesAssessmentHelp] (required);
  demands:[NoblesObligationHelp] (required); mandates:[NoblesObligationHelp] (required);
  accounting:NoblesAccountingHelp;
}
table NoblesRow {
  entity_id:int32 = -1; position_id:int32 = -1; assignment_id:int32 = -1;
  unit_id:int32 = -1; nemesis_id:int32 = -1; priority:int32;
  title:string (required); squad_caption:string (required); holder_caption:string (required);
  can_appoint:bool; has_room_assessment:bool;
  // Each vector has four entries: office/bedroom/dining/tomb, or chest/cabinet/rack/stand.
  required_rooms:[int32] (required); actual_rooms:[int32] (required);
  required_furniture:[int32] (required); actual_furniture:[int32] (required);
  // -1 absent, 0 fulfilled/export-only, 1 pending, 2 urgent, 3 critical.
  demand_status:int8 = -1; mandate_status:int8 = -1;
  // Independent full-body holder selector; absent is unavailable, never vacant.
  appearance:SelectionAppearance;
  help:NoblesHelp;
  draft_slot:uint32;
}
table NoblesState {
  outcome:NoblesOutcome; list_revision:uint64; total:uint32; offset:uint32;
  rows:[NoblesRow] (required);
  target:NoblesOffice; candidate_revision:uint64; candidates:[NoblesCandidate];
}

enum PlacesOutcome : uint8 { None, Rejected, Stale, Applied, Unknown }
table PlacesRequest { tab:uint8; offset:uint32; limit:uint16 = 32; expected_list_revision:uint64;
  building_id:int32 = -1; siege_action:int8 = -1; }
table PlacesRow {
  building_id:int32 = -1; position:TilePos;
  name:string (required); subtitle:string (required); job_caption:string (required);
  status_caption:string (required); secondary_status:string (required);
  status_overlay:string (required); operator_caption:string (required);
  additional_jobs:int32; siege_action:int8 = -1; appearance:SelectionAppearance;
  // Resolved location supplying a Zones subtitle; -1 for all other captions.
  subtitle_location_id:int32 = -1;
}
table PlacesState {
  outcome:PlacesOutcome; tab:uint8; list_revision:uint64; total:uint32; offset:uint32;
  rows:[PlacesRow] (required);
  building_id:int32 = -1; siege_action:int8 = -1;
}

// Tasks pages preserve native order. A nonzero offset requires the same list
// revision. Replies may contain fewer than limit rows to fit the payload budget.
enum TasksOutcome : uint8 { None, Applied, Rejected, Stale, Unknown }
enum TasksOperation : uint8 { Repeat, Suspend, RemoveWorker, Cancel }
table TasksRequest {
  offset:uint32; limit:uint16 = 32; expected_list_revision:uint64;
  job_id:int32 = -1; worker_id:int32 = -1; building_id:int32 = -1;
  expected_revision:uint64; operation:TasksOperation; expected_state:int8 = -1;
}
table TasksRow {
  job_id:int32 = -1; worker_id:int32 = -1; building_id:int32 = -1; revision:uint64;
  caption:string (required); worker_name:string (required); building_caption:string (required);
  worker_position:TilePos; building_position:TilePos; worker_color:AreaNameColor;
  can_view_job:bool; can_repeat:bool; can_remove_worker:bool; can_suspend:bool; can_cancel:bool;
  repeating:bool; suspended:bool;
  worker_appearance:SelectionAppearance; building_appearance:SelectionAppearance;
}
table TasksState {
  outcome:TasksOutcome; list_revision:uint64; total:uint32; offset:uint32;
  rows:[TasksRow] (required); job_id:int32 = -1;
}

// Owned Stocks semantic data. Legacy StocksOpen/List/Inspect/Close stay retired.
enum StocksMenuOutcome : uint8 { None, Applied, Rejected, Stale, Unknown }
enum StocksFlagAction : uint8 { Forbid, Dump, Melt, Hidden }
table StocksGroupKey { type:int16 = -1; subtype:int16 = -1; subcat1:int16 = -1; subcat2:int16 = -1; }
table StocksMenuRequest { category:int16 = -1; query:string (required); item_ids:[int32]; target:StocksGroupKey; expected_revision:uint64; operation:StocksFlagAction; value:int8 = -1; item_id:int32 = -1; page_request:uint64; page_offset:uint32; }
table StocksCategoryRow { type:int16 = -1; caption:string (required); stored:string (required); unavailable:string (required); matches:bool; }
table StocksGroupRow { key:StocksGroupKey (required); amount:int32; caption:string (required); matches:bool; expanded:bool; flags:uint8; revision:uint64; item_ids:[int32] (required); }
table StocksItemRow { id:int32 = -1; type:int16 = -1; caption:string (required); flags:uint32; can_dump:bool; can_melt:bool; material_token:string (required); subtype_raw:string (required); appearance:ItemInspectionAppearance; }
table StocksReplyPage { request_seq:uint64; total:uint32; offset:uint32; bytes:[uint8] (required); }
table StocksMenuState { outcome:StocksMenuOutcome; category:int16 = -1; categories:[StocksCategoryRow] (required); groups:[StocksGroupRow] (required); items:[StocksItemRow] (required); }

// Quantities are player-known counts, never hidden exact stock totals.
enum StockAccuracy : uint8 { Unavailable, Exact, Approximate }
table AppointmentRole { entity_id:int32; position_id:int32; assignment_id:int32 = -1; unit_id:int32 = -1; name:string; holder:string; office:int32; bedroom:int32; dining:int32; tomb:int32; boxes:int32; cabinets:int32; racks:int32; stands:int32; actionable:bool; reason:string; }
table AppointmentCandidate { unit_id:int32 = -1; name:string; skill:string; selectable:bool; reason:string; }
/// Exact native ingredient identity; permission 1=Cook, 2=Brew. One explicit edit.
table KitchenRequest { item_type:int32 = -1; item_subtype:int16 = -1; mat_type:int16 = -1; mat_index:int32 = -1; permission:uint8; allowed:int8 = -1; receipt:uint64; cursor:uint32; query:string; }
table KitchenIngredient { item_type:int32; item_subtype:int16 = -1; mat_type:int16 = -1; mat_index:int32 = -1; name:string; count:uint32; can_cook:bool; can_brew:bool; cook_allowed:bool; brew_allowed:bool; }
table KitchenState { open:bool; receipt:uint64; ingredients:[KitchenIngredient]; next_cursor:uint32; total:uint32; detail:string; }

table AppointmentsRequest { entity_id:int32 = -1; position_id:int32 = -1; assignment_id:int32 = -1; unit_id:int32 = -1; receipt:uint64; }
table AppointmentsState { open:bool; choosing:bool; receipt:uint64; roles:[AppointmentRole]; candidates:[AppointmentCandidate]; detail:string; }
table StockCount { amount:uint32; accuracy:StockAccuracy; }
table StocksRequest { category:int32 = -1; cursor:uint32; query:string; item_id:int32 = -1; receipt:uint64; }
table StockCategory { id:int32; name:string; available:StockCount; unavailable:StockCount; }
table StockItem { id:int32; category:int32; description:string; quantity:uint32 = 1; x:int32 = -1; y:int32 = -1; z:int32 = -1; can_focus:bool; }
table StocksState { open:bool; receipt:uint64; categories:[StockCategory]; items:[StockItem]; next_cursor:uint32; category:int32 = -1; detail:string; }
enum ManagementStatus : uint8 { Idle, Pending, Ok, Rejected }
table BuildingDefinition { key:string (required); name:string; width:uint16 = 1; height:uint16 = 1; supported:bool; reason:string;
  family:string; subtype_key:string; custom_code:string; native_name:string;
  // 0 unknown, 1 fixed, 2 sized, 3 per-tile, 4 stairs.
  area_mode:uint8;
  // Per-family facing bits: Bridge 0-3 directions, bit 4 retracting; SiegeEngine 0-7 facings (bit 4 Southeast); 0 unknown.
  orientations:uint8;
  max_width:uint16; max_height:uint16; max_depth:uint16;
  filters:[ConstructionFilter]; footprints:[ConstructionFootprint];
}
table ConstructionInput { id:int32; description:string; quantity:uint32; }
enum CreatureSectionKind : uint8 { Identity, Skills, Attributes, Health, Inventory, Relationships, Personality, Values, Needs, Dreams, Emotions, Preferences, Military, Labors, Rooms, Groups, Memories, Treatment, HealthHistory, Knowledge, Uniform, Kills, Workshops, Locations, WorkAnimals }
table CreatureFact { key:string; text:string; number:int64; has_number:bool; }
table CreatureRecord { id:int32 = -1; related_id:int32 = -1; name:string; facts:[CreatureFact]; }
table CreatureSection { kind:CreatureSectionKind; available:bool; truncated:bool; reason:string; records:[CreatureRecord]; }
table CreatureRequest { unit_id:int32 = -1; }
enum CreatureWorkshopOutcome : uint8 { Rejected, Applied, Unavailable }
table CreatureWorkshopRequest { unit_id:int32 = -1; building_id:int32 = -1; expected_revision:uint64; }
table CreatureWorkshopState { unit_id:int32 = -1; building_id:int32 = -1; outcome:CreatureWorkshopOutcome; }
enum CreatureLocationOutcome : uint8 { Rejected, Applied, Unavailable, Unknown }
table CreatureLocationRequest { unit_id:int32 = -1; occupation_id:int32 = -1; expected_revision:uint64; }
table CreatureLocationState { unit_id:int32 = -1; occupation_id:int32 = -1; outcome:CreatureLocationOutcome; }
enum CreatureAnimalOutcome : uint8 { Rejected, Applied, Unavailable, Unknown }
table CreatureAnimalRequest { unit_id:int32 = -1; animal_id:int32 = -1; expected_revision:uint64; assigned:bool; }
table CreatureAnimalState { unit_id:int32 = -1; animal_id:int32 = -1; outcome:CreatureAnimalOutcome; assigned:bool; }
enum CreatureKnowledgeOutcome : uint8 { Rejected, Ready, Unavailable }
table CreatureKnowledgeRequest { unit_id:int32 = -1; kind:int32 = -1; id:int32 = -1; }
table CreatureKnowledgeState { unit_id:int32 = -1; kind:int32 = -1; id:int32 = -1; outcome:CreatureKnowledgeOutcome; text:string (required); }
table CreaturePosition { unit_id:int32 = -1; position:TilePos; }
enum CreatureHeaderOutcome : uint8 { Rejected, Completed, Stale, Unknown }
table CreatureHeaderRequest { unit_id:int32 = -1; profession:bool; expected_revision:uint64; name:string; }
table CreatureHeaderSnapshot {
  unit_id:int32 = -1; historical_figure_id:int32 = -1; has_figure:bool; revision:uint64;
  nickname:string (required); profession:string (required); figure_nickname:string (required);
}
table CreatureHeaderState { outcome:CreatureHeaderOutcome; mutated:bool; snapshot:CreatureHeaderSnapshot; }
enum CreatureExpelOutcome : uint8 { Rejected, Ready, Applied, Unsupported, Unknown }
table CreatureExpelRequest { unit_id:int32 = -1; destination_id:int32 = -1; expected_unit_ids:[int32] (required); }
table CreatureExpelUnit { id:int32 = -1; name:string (required); name_color:AreaNameColor (required); sheet_icon:SelectionAppearance (required); }
table CreatureExpelDestination { id:int32 = -1; name:string (required); }
table CreatureExpelPreview {
  unit_id:int32 = -1; eligible:bool; reason:int32 = -1;
  units:[CreatureExpelUnit] (required); destinations:[CreatureExpelDestination] (required);
}
table CreatureExpelState { outcome:CreatureExpelOutcome; preview:CreatureExpelPreview; }
enum CreatureHealthPageKind : uint8 { Status, Wounds, Treatment, History, Description }
table CreatureHealthPage { kind:CreatureHealthPageKind; rows:[string] (required); }
enum CreatureSkillsPageKind : uint8 { Labor, Combat, Social, Other, Knowledge }
table CreatureSkillRow {
  id:int32 = -1; knowledge_type:int32 = -1; knowledge_bits:uint32;
  rating:int32; rust_value:int32; caption:string (required); subtitle:string (required);
  // Native text color: foreground bits0..2, background bits3..5, bold bit6.
  // Knowledge uses its category styling and leaves this skill-only value absent.
  caption_color:int16 = -1;
}
table CreatureSkillsPage { kind:CreatureSkillsPageKind; rows:[CreatureSkillRow] (required); }
table CreatureState {
  unit_id:int32 = -1; captured_tick:uint64; name:string; species:string; profession:string; job:string;
  age:int32 = -1; sex:int32 = -1; origin:TilePos; complete:bool; sections:[CreatureSection];
  portrait:SelectionAppearance;
  health_pages:[CreatureHealthPage];
  skills_pages:[CreatureSkillsPage];
}
// Materials orders candidates for the exact origin (rectangle minimum corner,
// bottom level). Place requires that same origin and each filter's Materials
// list revision; moving origin requires a fresh Materials scan at the new origin.
// A Materials "list exceeds cap" error stays failed across polls. Retry: request
// Catalog with cursor=0 and expected_list_revision=0, then request Materials.
// Dump direction:0 none,1 north,2 east,3 south,4 west. Native profile offsets
// are derived by the bridge; no native widget state crosses the command boundary.
table TrackStopOptions { friction:uint32 = 50000; dump_direction:uint8; }
// Native trigger profile, independent of staged native building UI state.
// Example-search buckets do not change these selected trigger endpoints.
table PressurePlateOptions {
  units:bool; water:bool; magma:bool; citizens:bool; resets:bool = true; track:bool;
  unit_min:int32 = 5000; unit_max:int32 = 200000;
  water_min:int8 = 1; water_max:int8 = 7;
  magma_min:int8 = 1; magma_max:int8 = 7;
  track_min:int32 = 1; track_max:int32 = 2000;
}
// Ordered connected Track intent: ConstructionRequest.origin is the first point.
// Rectangle dimensions do not encode either endpoint or a client-chosen route.
table ConnectedTrackOptions { destination:TilePos (required); }
table ConstructionRequest {
  schema_version:uint32 = 181;
  client_id:uint64;
  seq:uint64;
  world_epoch:uint64;
  action:ManagementAction;
  definition:string;
  origin:TilePos;
  width:uint16 = 1;
  height:uint16 = 1;
  direction:uint8;
  items:[int32];
  cursor:uint32;
  building_id:int32 = -1;
  area:AreaRequest;
  production:ProductionRequest;
  work_order:WorkOrderRequest;
  citizen:CitizenRequest;
  report:ReportRequest;
  agreement:AgreementRequest;
  trade:TradeRequest;
  stocks:StocksRequest;
  appointments:AppointmentsRequest;
  kitchen:KitchenRequest;
  alert:AlertRequest;
  selection:SelectionRequest;
  creature:CreatureRequest;
  depth:uint16 = 1;
  retracting:bool;
  filter:int16 = -1;
  selections:[ConstructionSelection];
  expected_list_revision:uint64;
  // Rollers Preview/Place: 10000..50000 in steps of10000; 0 uses native default.
  roller_speed:uint32;
  track_stop:TrackStopOptions;
  pressure_plate:PressurePlateOptions;
  connected_track:ConnectedTrackOptions;
  // Last selected corner for construction material admission; bounds remain normalized.
  material_anchor:TilePos;
  // Remove only: cancel an existing native DestroyBuilding job; never toggle.
  cancel_removal:bool;
  creature_header:CreatureHeaderRequest;
  creature_expel:CreatureExpelRequest;
  creature_knowledge:CreatureKnowledgeRequest;
  creature_workshop:CreatureWorkshopRequest;
  creature_location:CreatureLocationRequest;
  creature_animal:CreatureAnimalRequest;
  residents:ResidentsRequest;
  residents_rows:ResidentsRowsRequest;
  residents_specialization:ResidentsSpecializationRequest;
  residents_activity:ResidentsActivityRequest;
  job_settings:JobSettingsRequest;
  job_settings_edit:JobSettingsEditRequest;
  work_detail_workers:WorkDetailWorkersRequest;
  work_detail_settings:WorkDetailSettingsRequest;
  standing_orders:StandingOrdersRequest;
  hunter_ammunition:HunterAmmunitionRequest;
  chores:ChoresRequest;
  kitchen_menu:KitchenMenuRequest;
  stone_use:StoneUseRequest;
  stocks_menu:StocksMenuRequest;
  tasks:TasksRequest;
  places:PlacesRequest;
  nobles:NoblesRequest;
}
// Native ordered world-hover descriptions. Missing means unavailable, never guessed.
table WorldHoverEntry { text:string (required); foreground:uint8; background:uint8; bright:bool; kind:uint8; object_id:int32 = -1; }
table WorldHover { tile:TilePos; entries:[WorldHoverEntry] (required); }

table ManagementState {
  schema_version:uint32 = 181;
  revision:uint64;
  world_epoch:uint64;
  client_id:uint64;
  request_seq:uint64;
  action:ManagementAction;
  status:ManagementStatus;
  message:string;
  catalog:[BuildingDefinition];
  inputs:[ConstructionInput];
  required:uint16;
  next_cursor:uint32;
  placement_valid:bool;
  building_id:int32 = -1;
  build_stage:int16 = -1;
  max_stage:int16 = -1;
  removing:bool;
  jobs:uint16;
  terrain_construction:bool;
  area:AreaState;
  production:ProductionState;
  work_order:WorkOrderState;
  citizen:CitizenState;
  report:ReportState;
  agreement:AgreementState;
  trade:TradeState;
  stocks:StocksState;
  appointments:AppointmentsState;
  kitchen:KitchenState;
  alert:AlertState;
  selection:SelectionState;
  creature:CreatureState;
  construction:ConstructionState;
  world_hover:WorldHover;
  creature_header:CreatureHeaderState;
  creature_position:CreaturePosition;
  creature_expel:CreatureExpelState;
  creature_knowledge:CreatureKnowledgeState;
  creature_workshop:CreatureWorkshopState;
  creature_location:CreatureLocationState;
  creature_animal:CreatureAnimalState;
  residents:ResidentsState;
  residents_rows:ResidentsRowsState;
  residents_specialization:ResidentsSpecializationState;
  residents_activity:ResidentsActivityState;
  job_settings:JobSettingsState;
  job_settings_edit:JobSettingsEditState;
  work_detail_settings:WorkDetailSettingsState;
  standing_orders:StandingOrdersState;
  hunter_ammunition:HunterAmmunitionState;
  chores:ChoresState;
  kitchen_menu:KitchenMenuState;
  stone_use:StoneUseState;
  stocks_menu:StocksMenuState;
  stocks_page:StocksReplyPage;
  tasks:TasksState;
  places:PlacesState;
  nobles:NoblesState;
}

table WorkOrderInput { index:uint16; description:string; mat_type:int16 = -1; mat_index:int32 = -1; editable:bool; }
table WorkOrderMaterial { mat_type:int16 = -1; mat_index:int32 = -1; name:string; }
table WorkOrderTrait { key:string; name:string; }
table WorkOrderItemType { item_type:int16 = -1; item_subtype:int16 = -1; name:string; }
table WorkOrderGroup { type:int16 = -1; subtype:int16 = -1; custom:int32 = -1; name:string; count:uint32; custom_code:string; }
// Task keys and reactions <=64 B; names <=128 B. Identity fields must be >= -1.
table WorkOrderTask { key:string; name:string; job_type:int16 = -1; reaction:string; item_type:int16 = -1; item_subtype:int16 = -1; mat_type:int16 = -1; mat_index:int32 = -1; }

table ConstructionSelection {
  filter:int16 = -1; item_type:int16 = -1; item_subtype:int16 = -1;
  mat_type:int16 = -1; mat_index:int32 = -1; count:uint32;
  expected_list_revision:int64 = -1;
  // Present means exact identities, never permission to substitute group members.
  item_ids:[int32];
  // A native standalone item row, distinct from a same-material generic group.
  // Requires exactly this item ID; -1 denotes a generic group.
  individual_id:int32 = -1;
}
table ConstructionFilter {
  index:int16 = -1; item_type:int16 = -1; item_subtype:int16 = -1;
  caption:string; requirement:string; quantity:int32 = -1;
}
// Complete ordinary item rows in native expanded order (distance, then ID).
// Missing vector means legacy aggregate-only data, never an empty complete list.
// Owned semantic item facts; no native texture IDs or screen state. Absence
// means appearance is unavailable, not a default material or guessed icon.
table ConstructionItemAppearance {
  material_token:string; subtype_raw:string; color_token:string;
  stack:uint32 = 1; flags:uint8;
  bedding:BeddingFacts;
  instrument_family:int8 = -1; // unknown; keyboard/stringed/wind/percussion=0/1/2/3
  instrument_placed:int8 = -1; // unknown; raw definition portable=0, placed=1
  slab_engraving:int8 = -2; // unknown; native slab_engraving_type -1..26
  gem_shape_raw:string; // descriptor shape raw ID; absent means unknown
}
table ConstructionMaterialCandidate { id:int32 = -1; name:string; distance:uint32; appearance:ConstructionItemAppearance; }
table ConstructionMaterial {
  item_type:int16 = -1; item_subtype:int16 = -1; mat_type:int16 = -1;
  mat_index:int32 = -1; name:string; caption:string; count:uint32;
  candidates:[ConstructionMaterialCandidate];
  individual_id:int32 = -1;
  // Native generic Last-material name, distinct from a standalone display name.
  // Absence means no verified history copy; never strip decorations to infer it.
  last_name:string;
}
table ConstructionFootprint {
  direction:uint8; width:uint16; height:uint16;
  center_x:int16 = -1; center_y:int16 = -1;
}
// Exactly 200 ordered size thresholds when present, on the first Catalog page.
// race_id -1 means no example; the presentation uses the native numeric label.
table PressureCreatureExample { size:int32; race_id:int32 = -1; name:string; }
enum ConnectedTrackStatus:uint8 { Found, NoPath, InvalidInput, FrontierLimit, UnverifiedTerrain, PayloadLimit }
// Complete ordered path only; non-Found outcomes carry no partial geometry.
table ConnectedTrackPreview { status:ConnectedTrackStatus = UnverifiedTerrain; path:[TilePos]; }
enum ConstructionOutcome:uint8 { None, Complete, Rejected, Partial, Unknown }
table ConstructionState {
  building_key:string; filter:int16 = -1;
  filters:[ConstructionFilter]; materials:[ConstructionMaterial];
  total:uint32; list_revision:uint64; estimated:bool;
  build_phase:uint8; // Construction: 0 done, 1 read, 2 sort, 3 error (reported before explicit retry).
  build_done:uint32; build_total:uint32;
  placed:uint32; skipped:uint32; first_building:int32 = -1;
  // One byte per tile: x fastest, then y, then z upward from origin.z.
  valid_mask:[ubyte];
  // 0 unknown, 1 UpStair, 2 DownStair, 3 UpDownStair.
  pieces:[ubyte];
  footprint:ConstructionFootprint;
  pressure_creatures:[PressureCreatureExample];
  connected_track:ConnectedTrackPreview;
  outcome:ConstructionOutcome = None;
  updated:uint32; // Confirmed existing-job updates, distinct from newly placed jobs.
  failed_index:int32 = -1; // One-based plan index, or -1 when unavailable.
  warnings:string; // Native advisory copy, independent of placement validity and refusals.
}

root_type Snapshot;
