; DF3D Godot presentation; needs the df3d GDExtension DLL in res://bin/ and a DF with the df3d bridge.

config_version=5

[application]

config/name="DF3D"
config/description="A 3D presentation of a running Dwarf Fortress game, rendered from your own Steam install."
config/version="0.2.0"
run/main_scene="res://scenes/entry.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/resizable=false

[rendering]

renderer/rendering_method="forward_plus"
; Vulkan avoids per-surface D3D12 allocation padding; --rendering-driver d3d12 remains available.
rendering_device/driver.windows="vulkan"
; Low-cost geometric edge AA; pixel interiors use the shared sharp sampler.
anti_aliasing/quality/msaa_3d=1
textures/default_filters/anisotropic_filtering_level=2
; Separate rendering during gameplay; window dimensions change through Settings.
driver/threads/thread_model=2

[shader_globals]

machinery_calendar_tick={
"type": "int",
"value": -1
}

world_texture_smoothing={
"type": "bool",
"value": false
}

native_world_color={
"type": "bool",
"value": false
}

unit_status_clock={
"type": "float",
"value": 0.0
}

actor_motion_clock={
"type": "vec2",
"value": Vector2(0, 0)
}

actor_truescale={
"type": "bool",
"value": false
}

actor_animation_time={
"type": "float",
"value": 0.0
}
actor_animation_strength={
"type": "float",
"value": 0.55
}
